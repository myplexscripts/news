---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'London News',
  description = 'A fast local news reader for London, Ontario, gathering reporting from across the city.',
  noindex = false
} = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const onSources = path.includes('/sources/');
const onSections = path.includes('/sections/');
const onHome = !onSources && !onSections && !path.includes('/latest/') && !path.includes('/story/') && !path.includes('/admin/');
---
<!doctype html>
<html lang="en-CA" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('london-news-theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#page-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner header-inner-simple">
        <a class="brand" href={base} aria-label="London News home">
          <span class="brand-mark" aria-hidden="true"><i class="ph-fill ph-newspaper-clipping"></i></span>
          <span>London News</span>
        </a>

        <div class="header-actions">
          <slot name="header-actions" />
          <a class="icon-button desktop-sources-link" href={`${base}sources/`} aria-label="Manage news sources" title="Sources">
            <i class="ph ph-buildings" aria-hidden="true"></i>
          </a>
          <button class="icon-button" id="themeToggle" aria-label="Toggle appearance" title="Toggle appearance">
            <i class="ph ph-moon" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </header>

    <div id="page-content">
      <slot />
    </div>

    <footer class="site-footer shell">
      <div>
        <strong>London News</strong>
        <span>Local reporting from across London, Ontario</span>
      </div>
      <span>Times shown in London, Ontario</span>
    </footer>

    <nav class="mobile-tab-bar" aria-label="Primary navigation">
      <a
        id="mobileHomeTab"
        class:list={["mobile-tab", "mobile-home-tab", onHome && "active"]}
        href={base}
        aria-label="Home"
        title="Home"
        aria-current={onHome ? 'page' : undefined}
      >
        <i id="mobileHomeIcon" class={onHome ? 'ph-fill ph-house' : 'ph ph-house'} aria-hidden="true"></i>
        <span class="visually-hidden">Home</span>
      </a>
      <a
        class:list={["mobile-tab", onSections && "active"]}
        href={`${base}sections/`}
        aria-label="Sections"
        title="Sections"
        aria-current={onSections ? 'page' : undefined}
      >
        <i class={onSections ? 'ph-fill ph-squares-four' : 'ph ph-squares-four'} aria-hidden="true"></i>
        <span class="visually-hidden">Sections</span>
      </a>
      <a
        class:list={["mobile-tab", onSources && "active"]}
        href={`${base}sources/`}
        aria-label="Sources"
        title="Sources"
        aria-current={onSources ? 'page' : undefined}
      >
        <i class={onSources ? 'ph-fill ph-buildings' : 'ph ph-buildings'} aria-hidden="true"></i>
        <span class="visually-hidden">Sources</span>
      </a>
    </nav>

    <script is:inline>
      const root = document.documentElement;
      const themeToggle = document.getElementById('themeToggle');
      const themeIcon = themeToggle?.querySelector('i');

      function updateThemeIcon() {
        if (!themeIcon) return;
        themeIcon.className = root.dataset.theme === 'dark' ? 'ph ph-sun' : 'ph ph-moon';
      }

      updateThemeIcon();

      themeToggle?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('london-news-theme', root.dataset.theme);
        updateThemeIcon();
      });

      const mobileHomeTab = document.getElementById('mobileHomeTab');
      const mobileHomeIcon = document.getElementById('mobileHomeIcon');
      const homeIconClass = mobileHomeIcon?.className || 'ph ph-house';
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

      function syncMobileHomeAction() {
        if (!mobileHomeTab || !mobileHomeIcon) return;
        const threshold = Math.min(420, Math.max(240, window.innerHeight * 0.38));
        const backToTop = window.scrollY > threshold;
        mobileHomeTab.classList.toggle('is-back-to-top', backToTop);
        mobileHomeTab.setAttribute('aria-label', backToTop ? 'Back to top' : 'Home');
        mobileHomeTab.setAttribute('title', backToTop ? 'Back to top' : 'Home');
        mobileHomeIcon.className = backToTop ? 'ph ph-arrow-up' : homeIconClass;
      }

      mobileHomeTab?.addEventListener('click', (event) => {
        if (!mobileHomeTab.classList.contains('is-back-to-top')) return;
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      });

      let scrollFrame = 0;
      window.addEventListener('scroll', () => {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
          syncMobileHomeAction();
          scrollFrame = 0;
        });
      }, { passive: true });
      window.addEventListener('resize', syncMobileHomeAction, { passive: true });
      syncMobileHomeAction();
    </script>
  </body>
</html>
