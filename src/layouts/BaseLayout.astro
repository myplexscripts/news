---
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/mobile-card-fixes.css';
import '../styles/article-rich.css';
import '../styles/feed-scope.css';
import PipelineHealth from '../components/PipelineHealth.astro';
import UserStateBridge from '../components/UserStateBridge.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  homeDate?: string;
  homeUpdated?: string;
}

const {
  title = 'Forest City News',
  description = 'A fast local news reader for London, Ontario, gathering reporting from across the city.',
  noindex = false,
  homeDate,
  homeUpdated
} = Astro.props;

const BRAND_NAME = 'Forest City News';
const LEGACY_BRAND_NAME = 'London News';
const resolvedTitle = String(title || BRAND_NAME).split(LEGACY_BRAND_NAME).join(BRAND_NAME);
const resolvedDescription = String(description || '').split(LEGACY_BRAND_NAME).join(BRAND_NAME);
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const onSources = path.includes('/sources/');
const onSections = path.includes('/sections/');
const onSearch = path.includes('/search/');
const onReadLater = path.includes('/read-later/');
const onSettings = path.includes('/settings/');
const onAdmin = path.includes('/admin/');
const onHome = !onSources && !onSections && !onSearch && !onReadLater && !onSettings && !onAdmin && !path.includes('/latest/') && !path.includes('/story/');
const hasHeaderActions = Astro.slots.has('header-actions');
const showHomeMasthead = onHome && Boolean(homeDate);
const onDirectory = onSections || onSources;
const mobileTabIndex = onHome ? 0 : onDirectory ? 1 : onSearch ? 2 : onReadLater ? 3 : onSettings ? 4 : -1;
---
<!doctype html>
<html lang="en-CA" data-theme="light" data-accent="green" data-hide-read="false">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={resolvedDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#050505" />
    <title>{resolvedTitle}</title>
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/icon-180.png`} />
    <link rel="stylesheet" href={`${base}smart-features.css`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/duotone/style.css" />
    <style is:inline>
      .brand::after,
      .brand > span::after {
        content: none !important;
        display: none !important;
      }

      .brand-news {
        gap: 8px !important;
        font-size: 28px !important;
        line-height: 1 !important;
        font-weight: 800 !important;
        letter-spacing: -0.045em !important;
      }

      .brand-news-icon {
        flex: 0 0 auto;
        font-size: 34px !important;
        line-height: 1 !important;
      }

      .brand-news-wordmark {
        display: inline-block;
        transform: translateY(-1px);
      }

      @media (max-width: 760px) {
        .brand-news {
          gap: 7px !important;
          font-size: 26px !important;
        }

        .brand-news-icon {
          font-size: 32px !important;
        }

        .mobile-tab-bar {
          --mobile-tab-count: 5 !important;
          grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
        }
      }
    </style>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('london-news-theme');
        const preferredTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const savedAccent = localStorage.getItem('london-news-accent') || 'green';
        const hideRead = localStorage.getItem('london-news-hide-read') === 'true';
        document.documentElement.dataset.theme = savedTheme || preferredTheme;
        document.documentElement.dataset.accent = savedAccent;
        document.documentElement.dataset.hideRead = hideRead ? 'true' : 'false';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#page-content">Skip to content</a>

    <header class:list={["site-header", showHomeMasthead && "site-header-home"]}>
      <div class:list={["shell", "header-inner", "header-inner-simple", showHomeMasthead && "home-header-inner"]}>
        <div class="brand-area">
          <a class="brand brand-news" href={base} aria-label="Forest City News home">
            <i class="ph-fill ph-tree brand-news-icon" aria-hidden="true"></i>
            <span class="brand-news-wordmark">News</span>
          </a>
        </div>

        <div class="header-actions">
          <slot name="header-actions" />
          {!hasHeaderActions && (
            <a class="icon-button header-search-link" href={`${base}search/`} aria-label="Search news" title="Search">
              <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            </a>
          )}
          <a class:list={["icon-button", "desktop-sources-link", onDirectory && "active"]} href={`${base}sections/`} aria-label="Browse sections and sources" title="Sections" aria-current={onDirectory ? 'page' : undefined}>
            <i class={onDirectory ? 'ph-fill ph-hard-drives' : 'ph ph-hard-drives'} aria-hidden="true"></i>
          </a>
          <a class:list={["icon-button", "settings-link", onSettings && "active"]} href={`${base}settings/`} aria-label="Settings" title="Settings" aria-current={onSettings ? 'page' : undefined}>
            <i class={onSettings ? 'ph-fill ph-gear-six' : 'ph ph-gear-six'} aria-hidden="true"></i>
          </a>
        </div>

        {showHomeMasthead && (
          <div class="home-meta-row">
            <p class="home-header-date">{homeDate}</p>
            {homeUpdated && <p class="home-header-updated">Updated {homeUpdated}</p>}
          </div>
        )}
      </div>
    </header>

    <div id="page-content">
      {onAdmin && <PipelineHealth />}
      <slot />
    </div>

    <footer class="site-footer shell">
      <div>
        <strong>Forest City News</strong>
        <span>Local reporting from across London, Ontario</span>
      </div>
      <span>Times shown in London, Ontario</span>
    </footer>

    <nav class="mobile-tab-bar" aria-label="Primary navigation" data-active-index={String(mobileTabIndex)}>
      <span class="mobile-tab-indicator" aria-hidden="true"></span>
      <a
        id="mobileHomeTab"
        class:list={["mobile-tab", "mobile-home-tab", onHome && "active"]}
        href={base}
        data-mobile-tab-index="0"
        aria-label="Home"
        title="Home"
        aria-current={onHome ? 'page' : undefined}
      >
        <i id="mobileHomeIcon" class={onHome ? 'ph-fill ph-house' : 'ph ph-house'} aria-hidden="true"></i>
        <span class="visually-hidden">Home</span>
      </a>
      <a
        class:list={["mobile-tab", onDirectory && "active"]}
        href={`${base}sections/`}
        data-mobile-tab-index="1"
        aria-label="Sections"
        title="Sections"
        aria-current={onDirectory ? 'page' : undefined}
      >
        <i class={onDirectory ? 'ph-fill ph-hard-drives' : 'ph ph-hard-drives'} aria-hidden="true"></i>
        <span class="visually-hidden">Sections</span>
      </a>
      <a
        class:list={["mobile-tab", onSearch && "active"]}
        href={`${base}search/`}
        data-mobile-tab-index="2"
        aria-label="Search"
        title="Search"
        aria-current={onSearch ? 'page' : undefined}
      >
        <i class={onSearch ? 'ph-fill ph-magnifying-glass' : 'ph ph-magnifying-glass'} aria-hidden="true"></i>
        <span class="visually-hidden">Search</span>
      </a>
      <a
        class:list={["mobile-tab", onReadLater && "active"]}
        href={`${base}read-later/`}
        data-mobile-tab-index="3"
        aria-label="Read Later"
        title="Read Later"
        aria-current={onReadLater ? 'page' : undefined}
      >
        <i class={onReadLater ? 'ph-fill ph-bookmark-simple' : 'ph ph-bookmark-simple'} aria-hidden="true"></i>
        <span class="visually-hidden">Read Later</span>
      </a>
      <a
        class:list={["mobile-tab", onSettings && "active"]}
        href={`${base}settings/`}
        data-mobile-tab-index="4"
        aria-label="Settings"
        title="Settings"
        aria-current={onSettings ? 'page' : undefined}
      >
        <i class={onSettings ? 'ph-fill ph-gear-six' : 'ph ph-gear-six'} aria-hidden="true"></i>
        <span class="visually-hidden">Settings</span>
      </a>
    </nav>

    <UserStateBridge />

    <script is:inline>
      const mobileTabBar = document.querySelector('.mobile-tab-bar');
      const mobileTabs = [...document.querySelectorAll('[data-mobile-tab-index]')];
      const mobileHomeTab = document.getElementById('mobileHomeTab');
      const mobileHomeIcon = document.getElementById('mobileHomeIcon');
      const homeIconClass = mobileHomeIcon?.className || 'ph ph-house';
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

      if (mobileTabBar) {
        const serverIndex = Number(mobileTabBar.dataset.activeIndex ?? -1);
        const storedIndex = Number(sessionStorage.getItem('london-news-mobile-tab-index'));
        const storedIsValid = Number.isInteger(storedIndex) && storedIndex >= 0 && storedIndex < mobileTabs.length;
        const targetIndex = serverIndex >= 0 ? serverIndex : storedIsValid ? storedIndex : 0;
        const startIndex = storedIsValid ? storedIndex : targetIndex;

        mobileTabBar.dataset.activeIndex = String(targetIndex);
        mobileTabBar.style.setProperty('--indicator-index', String(startIndex));

        if (serverIndex < 0 && mobileTabs[targetIndex]) {
          mobileTabs[targetIndex].classList.add('context-active');
        }

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            mobileTabBar.style.setProperty('--indicator-index', String(targetIndex));
          });
        });

        sessionStorage.setItem('london-news-mobile-tab-index', String(targetIndex));
      }

      function syncMobileHomeAction() {
        if (!mobileHomeTab || !mobileHomeIcon) return;
        const threshold = Math.min(420, Math.max(240, window.innerHeight * 0.38));
        const backToTop = window.scrollY > threshold;
        mobileHomeTab.classList.toggle('is-back-to-top', backToTop);
        mobileHomeTab.setAttribute('aria-label', backToTop ? 'Back to top' : 'Home');
        mobileHomeTab.setAttribute('title', backToTop ? 'Back to top' : 'Home');
        mobileHomeIcon.className = backToTop ? 'ph ph-arrow-up' : homeIconClass;
      }

      mobileHomeTab?.addEventListener('click', (event) => {
        if (!mobileHomeTab.classList.contains('is-back-to-top')) return;
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      });

      let scrollFrame = 0;
      window.addEventListener('scroll', () => {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
          syncMobileHomeAction();
          scrollFrame = 0;
        });
      }, { passive: true });
      window.addEventListener('resize', syncMobileHomeAction, { passive: true });
      syncMobileHomeAction();
    </script>

    <script is:inline>
      const preferenceRoot = document.documentElement;

      function getReadStoryIds() {
        try {
          const value = JSON.parse(localStorage.getItem('london-news-read-articles') || '[]');
          return Array.isArray(value) ? value.map(String) : [];
        } catch {
          return [];
        }
      }

      function syncReadStoryState() {
        const readIds = getReadStoryIds();
        const readSet = new Set(readIds);
        const hideRead = localStorage.getItem('london-news-hide-read') === 'true';
        preferenceRoot.dataset.hideRead = hideRead ? 'true' : 'false';
        document.querySelectorAll('[data-story-id]').forEach((item) => {
          item.classList.toggle('is-read-story', readSet.has(String(item.dataset.storyId || '')));
        });
        window.dispatchEvent(new CustomEvent('london-news-read-state', {
          detail: { readIds, hideRead }
        }));
      }

      window.addEventListener('storage', (event) => {
        if (!['london-news-read-articles', 'london-news-hide-read'].includes(event.key || '')) return;
        syncReadStoryState();
      });
      window.addEventListener('london-news-read-history-changed', syncReadStoryState);
      syncReadStoryState();
    </script>

    <script is:inline>
      (() => {
        const oldName = 'London News';
        const newName = 'Forest City News';
        const replaceBrand = (value) => typeof value === 'string' ? value.split(oldName).join(newName) : value;

        document.title = replaceBrand(document.title);
        document.querySelectorAll('[placeholder], [aria-label], [title]').forEach((element) => {
          ['placeholder', 'aria-label', 'title'].forEach((attribute) => {
            if (!element.hasAttribute(attribute)) return;
            element.setAttribute(attribute, replaceBrand(element.getAttribute(attribute)));
          });
        });

        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const parent = node.parentElement;
            if (!parent || ['SCRIPT', 'STYLE', 'TEMPLATE'].includes(parent.tagName)) return NodeFilter.FILTER_REJECT;
            return node.nodeValue?.includes(oldName) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
          }
        });
        const matches = [];
        while (walker.nextNode()) matches.push(walker.currentNode);
        matches.forEach((node) => { node.nodeValue = replaceBrand(node.nodeValue); });
      })();
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register(new URL('sw.js', document.querySelector('link[rel="manifest"]')?.href || location.href).href).catch(() => {}));
      }
    </script>
  </body>
</html>
