---
import BaseLayout from '../layouts/BaseLayout.astro';
import news from '../../data/news.json';

const stories = news.stories || [];
const withImages = stories.filter((story) => story.image && story.content_status !== 'failed');
const lead = withImages.find((story) => (story.quality?.score ?? 70) >= 55) || withImages[0] || stories[0];
const feed = lead ? stories.filter((story) => story.id !== lead.id).slice(0, 60) : stories.slice(0, 60);
const categories = ['All', ...Array.from(new Set(stories.map((story) => story.category))).sort()];
const sources = Array.from(new Map(stories.map((story) => [story.source, story])).values());
const base = import.meta.env.BASE_URL;

const storyHref = (story) => `${base}story/${story.id}/`;
const categoryClass = (category = 'Local') => `category-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const published = (value) => {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const generated = news.generated_at
  ? new Intl.DateTimeFormat('en-CA', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(news.generated_at))
  : 'Waiting for first refresh';
---
<BaseLayout>
  <button slot="header-actions" class="icon-button" id="searchToggle" aria-label="Search news" title="Search news">
    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
  </button>

  <div slot="header-panel" class="search-panel" id="searchPanel" hidden>
    <div class="shell search-inner">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      <input id="searchInput" type="search" placeholder="Search London news" autocomplete="off" />
      <button id="searchClose" class="text-button">Done</button>
    </div>
  </div>

  <main class="home-page">
    <section class="news-intro shell">
      <div class="news-intro-copy">
        <span class="eyebrow"><i class="ph-fill ph-map-pin"></i> London, Ontario</span>
        <h1>London, at a glance.</h1>
        <p>A clean daily read of what is happening across the city, gathered from local reporting.</p>
      </div>
      <div class="news-intro-status">
        <span>Last refreshed</span>
        <strong>{generated}</strong>
        <small>{news.full_story_count || 0} full articles captured</small>
      </div>
    </section>

    <section class="filter-strip shell" aria-label="News categories">
      <div class="filter-scroller" id="filters">
        {categories.map((category) => (
          <button class:list={["filter-pill", category === 'All' && 'active']} data-filter={category}>{category}</button>
        ))}
      </div>
    </section>

    {lead ? (
      <section class:list={["lead-story shell searchable", categoryClass(lead.category)]} data-category={lead.category} data-search={`${lead.title} ${lead.summary} ${lead.source} ${lead.category}`.toLowerCase()}>
        <a class="lead-media" href={storyHref(lead)} aria-label={`Read ${lead.title}`}>
          {lead.image ? <img src={lead.image} alt="" loading="eager" referrerpolicy="no-referrer" /> : <div class="image-fallback"><i class="ph-fill ph-buildings"></i></div>}
        </a>
        <div class="lead-copy">
          <div class="story-meta">
            <span class="source-dot" style={`--source-color:${lead.source_accent}`}></span>
            <span>{lead.source}</span>
            <span class="meta-separator">•</span>
            <time datetime={lead.published}>{published(lead.published)}</time>
          </div>
          <span class="section-label">{lead.category}</span>
          <h2><a href={storyHref(lead)}>{lead.title}</a></h2>
          {lead.summary && <p>{lead.summary}</p>}
          <a class="read-link" href={storyHref(lead)}>Read full story <i class="ph ph-arrow-right"></i></a>
        </div>
      </section>
    ) : (
      <section class="empty-state shell">
        <div class="empty-icon"><i class="ph ph-newspaper"></i></div>
        <h2>The newsroom is ready.</h2>
        <p>Your first refresh will populate this page automatically.</p>
      </section>
    )}

    {feed.length > 0 && (
      <section class="blog-layout shell" id="latest">
        <div class="feed-column">
          <header class="blog-section-header">
            <div>
              <span class="eyebrow">Latest</span>
              <h2>The local feed</h2>
            </div>
            <span>{stories.length} stories</span>
          </header>

          <div class="feed-list">
            {feed.map((story) => (
              <article class:list={["feed-post searchable", categoryClass(story.category)]} data-category={story.category} data-search={`${story.title} ${story.summary} ${story.source} ${story.category}`.toLowerCase()}>
                <div class="feed-post-copy">
                  <div class="story-meta">
                    <span class="source-dot" style={`--source-color:${story.source_accent}`}></span>
                    <span>{story.source}</span>
                    <span class="meta-separator">•</span>
                    <time datetime={story.published}>{published(story.published)}</time>
                  </div>
                  <span class="feed-category">{story.category}</span>
                  <h3><a href={storyHref(story)}>{story.title}</a></h3>
                  {story.summary && <p>{story.summary}</p>}
                  <div class="feed-post-footer">
                    <a href={storyHref(story)}>Read story <i class="ph ph-arrow-right"></i></a>
                    {story.word_count > 0 && <span>{Math.max(1, Math.round(story.word_count / 220))} min read</span>}
                  </div>
                </div>
                <a class="feed-thumb" href={storyHref(story)} aria-label={`Read ${story.title}`}>
                  {story.image ? <img src={story.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class="thumb-fallback"><i class="ph ph-newspaper-clipping"></i></div>}
                </a>
              </article>
            ))}
          </div>
        </div>

        <aside class="blog-sidebar" id="sources">
          <div class="sidebar-section" id="sections">
            <span class="eyebrow">Sections</span>
            <div class="section-links">
              {categories.filter((category) => category !== 'All').map((category) => (
                <button class:list={["section-link", categoryClass(category)]} data-side-filter={category}>
                  <span class="section-color"></span>
                  <span>{category}</span>
                  <i class="ph ph-arrow-right"></i>
                </button>
              ))}
            </div>
          </div>

          <div class="sidebar-section source-directory">
            <span class="eyebrow">Sources</span>
            <div class="source-list">
              {sources.map((source) => (
                <a class="source-row" href={source.source_home} target="_blank" rel="noopener noreferrer">
                  <span class="source-avatar" style={`--source-color:${source.source_accent}`}>{source.source.split(' ').map((part) => part[0]).slice(0,2).join('')}</span>
                  <span class="source-name">{source.source}</span>
                  <i class="ph ph-arrow-up-right"></i>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </section>
    )}

    <section class="no-results shell" id="noResults" hidden>
      <div class="empty-icon"><i class="ph ph-magnifying-glass"></i></div>
      <h2>No matching stories</h2>
      <p>Try another search or section.</p>
    </section>
  </main>

  <script is:inline>
    const searchPanel = document.getElementById('searchPanel');
    const searchToggle = document.getElementById('searchToggle');
    const searchClose = document.getElementById('searchClose');
    const searchInput = document.getElementById('searchInput');
    const noResults = document.getElementById('noResults');
    let activeFilter = 'All';

    function openSearch() {
      if (!searchPanel) return;
      searchPanel.hidden = false;
      requestAnimationFrame(() => searchInput?.focus());
    }

    function closeSearch() {
      if (!searchPanel) return;
      searchPanel.hidden = true;
      if (searchInput) searchInput.value = '';
      applyFilters();
    }

    function setFilter(category) {
      activeFilter = category || 'All';
      document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('active', item.dataset.filter === activeFilter));
      applyFilters();
      document.getElementById('latest')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    searchToggle?.addEventListener('click', openSearch);
    searchClose?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', applyFilters);

    document.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.filter || 'All')));
    document.querySelectorAll('[data-side-filter]').forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.sideFilter || 'All')));

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;
      document.querySelectorAll('.searchable').forEach((item) => {
        const categoryMatch = activeFilter === 'All' || item.dataset.category === activeFilter;
        const queryMatch = !query || (item.dataset.search || '').includes(query);
        const show = categoryMatch && queryMatch;
        item.classList.toggle('filtered-out', !show);
        if (show) visible += 1;
      });
      if (noResults) noResults.hidden = visible !== 0;
    }
  </script>
</BaseLayout>
