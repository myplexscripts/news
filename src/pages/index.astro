---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import news from '../../data/news.json';
import { collapseTimelineStories } from '../lib/timelineStories';
import '../styles/editorial-home.css';

const storyTime = (story) => story.cluster_latest_published || story.published;
const sourceScopeByName = new Map(
  (news.source_health || []).map((source) => [
    String(source.source || '').trim(),
    String(source.scope || '').trim().toLowerCase()
  ])
);

const scopeOf = (story) => {
  const explicit = String(story.scope || '').trim().toLowerCase();
  if (explicit === 'local' || explicit === 'canada') return explicit;

  const source = String(story.source || '').trim();
  const discovery = String(story.discovery_via || '').trim();
  if (sourceScopeByName.get(source) === 'canada' || sourceScopeByName.get(discovery) === 'canada') return 'canada';
  return 'local';
};

const newestFirst = (pool) => collapseTimelineStories(pool)
  .sort((a, b) => Date.parse(storyTime(b) || '') - Date.parse(storyTime(a) || ''));

const allStories = (news.stories || []).map((story) => ({ ...story, scope: scopeOf(story) }));
const localStories = newestFirst(allStories.filter((story) => story.scope === 'local')).slice(0, 90);
const canadaStories = newestFirst(allStories.filter((story) => story.scope === 'canada')).slice(0, 90);
const stories = newestFirst([...localStories, ...canadaStories]).slice(0, 180);

const scopeCategories = new Set(['Local', 'Canada']);
const preferredCategoryOrder = ['Public Safety', 'City Hall', 'Business', 'Traffic', 'Education', 'Health', 'Community', 'Sports'];
const discoveredCategories = Array.from(new Set(stories.map((story) => story.category).filter((category) => category && !scopeCategories.has(category))));
const orderedCategories = [
  ...preferredCategoryOrder.filter((category) => discoveredCategories.includes(category)),
  ...discoveredCategories.filter((category) => !preferredCategoryOrder.includes(category)).sort()
];
const primaryCategories = orderedCategories.slice(0, 4);
const moreCategories = orderedCategories.slice(4);
const base = import.meta.env.BASE_URL;
const categoryClass = (category = 'Local') => `category-${String(category).toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const dataSearchFor = (story) => `${story.title} ${story.summary || ''} ${(story.cluster_sources || [story.source]).join(' ')} ${story.category || ''}`.toLowerCase();

const buildTopLayout = (scope, pool) => {
  const newest = [...pool]
    .sort((a, b) => Date.parse(storyTime(b) || '') - Date.parse(storyTime(a) || ''))
    .slice(0, 3);
  return {
    scope,
    leadStory: newest[0],
    supportStories: newest.slice(1, 3)
  };
};

const topLayouts = [
  buildTopLayout('local', localStories),
  buildTopLayout('canada', canadaStories),
  buildTopLayout('all', stories)
];

const storyIndex = new Map(stories.map((story, index) => [story.id, index]));

const localDateKey = (value) => {
  try {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    }).formatToParts(new Date(value));
    const values = Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
    return `${values.year}-${values.month}-${values.day}`;
  } catch {
    return '1970-01-01';
  }
};

const dayNumber = (key) => {
  const [year, month, day] = key.split('-').map(Number);
  return Math.floor(Date.UTC(year, month - 1, day) / 86400000);
};

const referenceDate = news.generated_at || new Date().toISOString();
const referenceDay = dayNumber(localDateKey(referenceDate));
const groupKeyFor = (value) => {
  const diff = referenceDay - dayNumber(localDateKey(value));
  if (diff <= 0) return 'today';
  if (diff === 1) return 'yesterday';
  if (diff === 2) return 'two-days-ago';
  return 'earlier';
};

const groupLabels = {
  today: 'Today',
  yesterday: 'Yesterday',
  'two-days-ago': 'Two Days Ago',
  earlier: 'Earlier'
};
const groupOrder = ['today', 'yesterday', 'two-days-ago', 'earlier'];
const dateGroups = groupOrder
  .map((key) => ({ key, label: groupLabels[key], stories: stories.filter((story) => groupKeyFor(storyTime(story)) === key) }))
  .filter((group) => group.stories.length > 0);

const todayLabel = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'America/Toronto',
  month: 'long',
  day: 'numeric'
}).format(new Date(referenceDate));

const generated = news.generated_at
  ? new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      hour: 'numeric',
      minute: '2-digit'
    }).format(new Date(news.generated_at))
  : 'waiting for refresh';
---
<BaseLayout homeDate={todayLabel} homeUpdated={generated}>
  <div slot="header-actions" class="header-search desktop-header-search" id="headerSearch">
    <button class="header-search-toggle" id="searchToggle" aria-label="Search news" title="Search news" aria-expanded="false" aria-controls="searchInput">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
    </button>
    <input id="searchInput" type="search" placeholder="Search Forest City News" autocomplete="off" aria-label="Search Forest City News" />
    <button class="header-search-close" id="searchClose" aria-label="Close search" title="Close search">
      <i class="ph ph-x-circle" aria-hidden="true"></i>
    </button>
  </div>

  <main class="home-page card-home editorial-home" id="main-content">
    <section class="section-nav-wrap card-filter-wrap" aria-label="News filters">
      <div class="shell section-nav-inner card-filter-inner">
        <div class="feed-scope-row">
          <div class="feed-scope-switch" role="group" aria-label="Choose home feed">
            <button class="feed-scope-button active" type="button" data-scope-filter="local" aria-pressed="true">Local</button>
            <button class="feed-scope-button" type="button" data-scope-filter="canada" aria-pressed="false">Canada</button>
            <button class="feed-scope-button" type="button" data-scope-filter="all" aria-pressed="false">All</button>
          </div>
        </div>

        <div class="section-tabs" role="group" aria-label="Filter by section">
          <button class="section-tab active" data-filter="All" aria-pressed="true">Latest</button>
          {primaryCategories.map((category) => (
            <button class:list={["section-tab", categoryClass(category)]} data-filter={category} aria-pressed="false">{category}</button>
          ))}
          {moreCategories.length > 0 && (
            <details class="control-menu" id="sectionMore">
              <summary>
                <span id="moreLabel">More</span>
                <i class="ph ph-caret-down" aria-hidden="true"></i>
              </summary>
              <div class="control-popover section-popover">
                {moreCategories.map((category) => (
                  <button class:list={["control-menu-item", categoryClass(category)]} data-filter={category}>
                    <span class="section-color" aria-hidden="true"></span>
                    <span>{category}</span>
                  </button>
                ))}
              </div>
            </details>
          )}
        </div>
      </div>
    </section>

    {topLayouts.map((layout) => (
      (layout.leadStory || layout.supportStories.length > 0) && (
        <section
          class="editorial-front shell"
          data-editorial-section="front"
          data-editorial-scope={layout.scope}
          hidden={layout.scope !== 'local'}
        >
          <div class="editorial-home-heading">
            <div><h2>Today</h2></div>
          </div>
          <div class="editorial-front-grid">
            {layout.leadStory && (
              <div class="editorial-lead-slot">
                <NewsCard
                  story={layout.leadStory}
                  index={layout.scope === 'local' ? 0 : 99}
                  variant="featured"
                  searchable={true}
                  dateGroup={groupKeyFor(storyTime(layout.leadStory))}
                  dataSearch={dataSearchFor(layout.leadStory)}
                  className="editorial-lead-card"
                />
              </div>
            )}
            {layout.supportStories.length > 0 && (
              <div class="editorial-support-stack">
                {layout.supportStories.map((story, index) => (
                  <NewsCard
                    story={story}
                    index={layout.scope === 'local' ? index + 1 : 99}
                    variant="featured"
                    searchable={true}
                    dateGroup={groupKeyFor(storyTime(story))}
                    dataSearch={dataSearchFor(story)}
                    className="editorial-support-card"
                  />
                ))}
              </div>
            )}
          </div>
        </section>
      )
    ))}

    <section class="news-card-section shell editorial-timeline" id="latest" aria-labelledby="latest-heading">
      <header class="news-card-section-header editorial-home-heading">
        <div><h2 id="latest-heading">Latest</h2></div>
        <p class="results-status visually-hidden" id="resultsStatus" aria-live="polite">Newest local stories shown first</p>
      </header>

      <div class="news-card-grid" id="newsCardGrid">
        {dateGroups.map((group) => (
          <>
            <header class="story-date-heading" data-date-heading={group.key}>
              <h2>{group.label}</h2>
            </header>
            {group.stories.map((story) => {
              const index = storyIndex.get(story.id) ?? 99;
              return (
                <NewsCard
                  story={story}
                  index={index}
                  variant="standard"
                  searchable={true}
                  dateGroup={group.key}
                  dataSearch={dataSearchFor(story)}
                />
              );
            })}
          </>
        ))}
      </div>

      <div class="no-results card-no-results" id="noResults" hidden>
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <h2>No matching stories</h2>
        <p>Try another feed, section, or search term, or review your hidden sources.</p>
        <a class="bordered-button" href={`${base}sources/`}>Manage sources</a>
      </div>
    </section>
  </main>

  <script>
    import { initialiseUserState, onUserStateChange } from '../lib/userState';

    const FEED_SCOPE_KEY = 'london-news-home-feed';
    const VALID_SCOPES = new Set(['local', 'canada', 'all']);
    const headerSearch = document.getElementById('headerSearch');
    const searchToggle = document.getElementById('searchToggle');
    const searchClose = document.getElementById('searchClose');
    const searchInput = document.getElementById('searchInput');
    const noResults = document.getElementById('noResults');
    const resultsStatus = document.getElementById('resultsStatus');
    const sectionMore = document.getElementById('sectionMore');
    const moreLabel = document.getElementById('moreLabel');
    const cards = [...document.querySelectorAll('.news-card.searchable')];
    const timelineCards = [...document.querySelectorAll('#newsCardGrid .news-card.searchable')];
    const timelineCardSet = new Set(timelineCards);
    const editorialCards = cards.filter((card) => !timelineCardSet.has(card));
    const dateHeadings = [...document.querySelectorAll('[data-date-heading]')];
    const scopeButtons = [...document.querySelectorAll('[data-scope-filter]')];
    const editorialSections = [...document.querySelectorAll('[data-editorial-section]')];

    let activeFilter = 'All';
    let activeScope = 'local';
    let hiddenSources = new Set();
    let readStories = new Set();
    let hideReadStories = false;

    function applyUserState(state) {
      hiddenSources = new Set(state.hiddenSources || []);
      readStories = new Set((state.readIds || []).map(String));
      hideReadStories = Boolean(state.hideRead);
      applyFilters();
    }

    function openSearch() {
      headerSearch?.classList.add('is-open');
      searchToggle?.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => searchInput?.focus());
    }

    function closeSearch() {
      headerSearch?.classList.remove('is-open');
      searchToggle?.setAttribute('aria-expanded', 'false');
      if (searchInput instanceof HTMLInputElement) searchInput.value = '';
      applyFilters();
      searchToggle?.focus();
    }

    function setScope(value, persist = true) {
      const next = VALID_SCOPES.has(value) ? value : 'local';
      activeScope = next;
      scopeButtons.forEach((item) => {
        const selected = item.dataset.scopeFilter === next;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      if (persist) {
        try { localStorage.setItem(FEED_SCOPE_KEY, next); } catch {}
      }
      applyFilters();
    }

    function setFilter(value) {
      activeFilter = value;
      document.querySelectorAll('.section-tab[data-filter]').forEach((item) => {
        const selected = item.dataset.filter === value;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      document.querySelectorAll('.control-menu-item[data-filter]').forEach((item) => item.classList.toggle('active-filter', item.dataset.filter === value));
      if (moreLabel) moreLabel.textContent = [...document.querySelectorAll('.control-menu-item[data-filter]')].some((item) => item.dataset.filter === value) ? value : 'More';
      sectionMore?.removeAttribute('open');
      applyFilters();
    }

    function cardMatches(item, query) {
      const itemScope = String(item.dataset.scope || '').toLowerCase();
      const scopeMatch = activeScope === 'all' || itemScope === activeScope;
      const categoryMatch = activeFilter === 'All' || item.dataset.category === activeFilter;
      const queryMatch = !query || (item.dataset.search || '').includes(query);
      const clusterSources = (item.dataset.sources || item.dataset.source || '').split('|').filter(Boolean);
      const sourceMatch = clusterSources.length === 0 || clusterSources.some((source) => !hiddenSources.has(source));
      const readMatch = !hideReadStories || !readStories.has(String(item.dataset.storyId || ''));
      return scopeMatch && categoryMatch && queryMatch && sourceMatch && readMatch;
    }

    function updateDateHeadings() {
      dateHeadings.forEach((heading) => {
        const key = heading.dataset.dateHeading;
        const hasVisibleStories = timelineCards.some((card) => card.dataset.dateGroup === key && !card.classList.contains('filtered-out'));
        heading.hidden = !hasVisibleStories;
      });
    }

    function updateEditorialVisibility() {
      editorialSections.forEach((section) => {
        const scopeMatch = section.dataset.editorialScope === activeScope;
        const sectionCards = [...section.querySelectorAll('.news-card.searchable')];
        section.hidden = !scopeMatch || !sectionCards.some((card) => !card.classList.contains('filtered-out'));
      });
    }

    function applyFilters() {
      const query = (searchInput instanceof HTMLInputElement ? searchInput.value : '').trim().toLowerCase();
      const visibleCards = [];
      const visibleEditorialIds = new Set();

      editorialCards.forEach((item) => {
        const layout = item.closest('[data-editorial-scope]');
        const layoutMatch = layout?.dataset.editorialScope === activeScope;
        const show = Boolean(layoutMatch) && cardMatches(item, query);
        item.classList.toggle('filtered-out', !show);
        if (show) {
          visibleCards.push(item);
          visibleEditorialIds.add(String(item.dataset.storyId || ''));
        }
      });

      timelineCards.forEach((item) => {
        const duplicateOfEditorial = visibleEditorialIds.has(String(item.dataset.storyId || ''));
        const show = cardMatches(item, query) && !duplicateOfEditorial;
        item.classList.toggle('filtered-out', !show);
        if (show) visibleCards.push(item);
      });

      updateDateHeadings();
      updateEditorialVisibility();
      if (noResults) noResults.hidden = visibleCards.length !== 0;
      if (resultsStatus) {
        const qualifiers = [activeScope === 'local' ? 'Local' : activeScope === 'canada' ? 'Canada' : 'All'];
        if (activeFilter !== 'All') qualifiers.push(activeFilter);
        if (query) qualifiers.push(`“${query}”`);
        if (hiddenSources.size) qualifiers.push(`${hiddenSources.size} hidden ${hiddenSources.size === 1 ? 'source' : 'sources'}`);
        if (hideReadStories) qualifiers.push('read stories hidden');
        resultsStatus.textContent = visibleCards.length === 0
          ? 'No matching stories'
          : `Newest matching stories shown first · ${qualifiers.join(' · ')}`;
      }
    }

    function setupCardReveals() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion || !('IntersectionObserver' in window)) {
        cards.forEach((card) => card.classList.add('is-revealed'));
        return;
      }

      cards.forEach((card, index) => {
        card.classList.add('home-card-reveal');
        card.style.setProperty('--home-card-reveal-delay', `${(index % 3) * 45}ms`);
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        });
      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -4% 0px'
      });

      cards.forEach((card) => observer.observe(card));
    }

    searchToggle?.addEventListener('click', () => headerSearch?.classList.contains('is-open') ? searchInput?.focus() : openSearch());
    searchClose?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', applyFilters);
    searchInput?.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeSearch(); });
    document.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.filter || 'All')));
    scopeButtons.forEach((button) => button.addEventListener('click', () => setScope(button.dataset.scopeFilter || 'local')));

    document.addEventListener('click', (event) => {
      if (sectionMore?.hasAttribute('open') && !sectionMore.contains(event.target)) sectionMore.removeAttribute('open');
    });

    const pageParams = new URLSearchParams(window.location.search);
    const requestedSection = pageParams.get('section');
    const requestedScope = pageParams.get('scope');
    let storedScope = 'local';
    try { storedScope = localStorage.getItem(FEED_SCOPE_KEY) || 'local'; } catch {}
    setScope(requestedScope && VALID_SCOPES.has(requestedScope) ? requestedScope : storedScope, false);

    if (pageParams.get('search') === '1') openSearch();
    if (requestedSection && cards.some((card) => card.dataset.category === requestedSection)) {
      setFilter(requestedSection);
      document.getElementById('latest')?.scrollIntoView({ block: 'start' });
    } else {
      applyFilters();
    }

    setupCardReveals();
    initialiseUserState().then(applyUserState).catch(() => {});
    onUserStateChange(applyUserState);
  </script>
</BaseLayout>
