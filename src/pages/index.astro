---
import BaseLayout from '../layouts/BaseLayout.astro';
import news from '../../data/news.json';

const stories = news.stories || [];
const withImages = stories.filter((story) => story.image);
const lead = withImages[0] || stories[0];
const remaining = lead ? stories.filter((story) => story.id !== lead.id) : stories;
const latest = remaining.slice(0, 9);
const moreStories = remaining.slice(9, 39);
const categories = ['All', ...Array.from(new Set(stories.map((story) => story.category))).sort()];
const sources = Array.from(new Map(stories.map((story) => [story.source, story])).values());
const base = import.meta.env.BASE_URL;

const storyHref = (story) => `${base}story/${story.id}/`;

const categoryClass = (category = 'Local') => `category-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const published = (value) => {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const relativeGenerated = news.generated_at
  ? new Intl.DateTimeFormat('en-CA', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(news.generated_at))
  : 'Waiting for first refresh';
---
<BaseLayout>
  <button slot="header-actions" class="icon-button" id="searchToggle" aria-label="Search news" title="Search news">
    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
  </button>

  <div slot="header-panel" class="search-panel" id="searchPanel" hidden>
    <div class="shell search-inner">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      <input id="searchInput" type="search" placeholder="Search London news" autocomplete="off" />
      <button id="searchClose" class="text-button">Done</button>
    </div>
  </div>

  <main>
    <section class="masthead shell">
      <div class="masthead-copy">
        <div class="location-line"><i class="ph-fill ph-map-pin"></i><span>London, Ontario</span></div>
        <h1>What London is talking about.</h1>
        <p class="lede">One calm, current view of reporting from across the city.</p>
      </div>
      <div class="update-status" title={`Last refreshed ${relativeGenerated}`}>
        <span class="status-dot" aria-hidden="true"></span>
        <div>
          <span>Updated</span>
          <strong>{relativeGenerated}</strong>
        </div>
      </div>
    </section>

    <section class="filter-strip shell" aria-label="News categories">
      <div class="filter-scroller" id="filters">
        {categories.map((category) => (
          <button class:list={["filter-pill", category === 'All' && 'active']} data-filter={category}>{category}</button>
        ))}
      </div>
    </section>

    {lead ? (
      <section class:list={["hero shell searchable", categoryClass(lead.category)]} data-category={lead.category} data-search={`${lead.title} ${lead.summary} ${lead.source} ${lead.category}`.toLowerCase()}>
        <a class="hero-media" href={storyHref(lead)} aria-label={`Read ${lead.title}`}>
          {lead.image ? <img src={lead.image} alt="" loading="eager" referrerpolicy="no-referrer" /> : <div class="image-fallback"><i class="ph-fill ph-buildings"></i></div>}
        </a>
        <div class="hero-copy">
          <div class="story-meta">
            <span class="source-dot" style={`--source-color:${lead.source_accent}`}></span>
            <span>{lead.source}</span>
            <span class="meta-separator">•</span>
            <time datetime={lead.published}>{published(lead.published)}</time>
          </div>
          <span class="category-chip">{lead.category}</span>
          <h2><a href={storyHref(lead)}>{lead.title}</a></h2>
          {lead.summary && <p class="hero-summary">{lead.summary}</p>}
          <a class="read-link" href={storyHref(lead)}>
            Read story
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </section>
    ) : (
      <section class="empty-state shell">
        <div class="empty-icon"><i class="ph ph-newspaper"></i></div>
        <h2>The newsroom is ready.</h2>
        <p>Your first refresh will populate this page automatically.</p>
      </section>
    )}

    {stories.length > 0 && (
      <section class="content-grid shell" id="latest">
        <div class="latest-column">
          <div class="section-heading">
            <div>
              <span class="section-kicker">Now</span>
              <h2>Latest</h2>
            </div>
            <span>{stories.length} stories</span>
          </div>

          <div class="latest-list">
            {latest.map((story) => (
              <article class:list={["latest-item searchable", categoryClass(story.category)]} data-category={story.category} data-search={`${story.title} ${story.summary} ${story.source} ${story.category}`.toLowerCase()}>
                <div class="latest-copy">
                  <div class="story-meta">
                    <span class="source-dot" style={`--source-color:${story.source_accent}`}></span>
                    <span>{story.source}</span>
                    <span class="meta-separator">•</span>
                    <time datetime={story.published}>{published(story.published)}</time>
                  </div>
                  <h3><a href={storyHref(story)}>{story.title}</a></h3>
                  {story.summary && <p>{story.summary}</p>}
                  <span class="inline-category">{story.category}</span>
                </div>
                <a class="latest-thumb" href={storyHref(story)} aria-label={`Read ${story.title}`}>
                  {story.image ? <img src={story.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class="thumb-fallback"><i class="ph ph-newspaper-clipping"></i></div>}
                </a>
              </article>
            ))}
          </div>
        </div>

        <aside class="sources-column" id="sources">
          <div class="section-heading compact">
            <div>
              <span class="section-kicker">Following</span>
              <h2>Sources</h2>
            </div>
          </div>
          <div class="source-panel">
            <div class="source-list">
              {sources.map((source) => (
                <a class="source-row" href={source.source_home} target="_blank" rel="noopener noreferrer">
                  <span class="source-avatar" style={`--source-color:${source.source_accent}`}>{source.source.split(' ').map((part) => part[0]).slice(0,2).join('')}</span>
                  <span class="source-name">{source.source}</span>
                  <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </div>
          <div class="about-card">
            <i class="ph ph-info" aria-hidden="true"></i>
            <p>Stories open here first. Original reporting remains credited and linked to its publisher.</p>
          </div>
        </aside>
      </section>
    )}

    {moreStories.length > 0 && (
      <section class="more-section shell" id="local">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Across London</span>
            <h2>More local news</h2>
          </div>
        </div>
        <div class="story-grid" id="storyGrid">
          {moreStories.map((story) => (
            <article class:list={["story-card searchable", categoryClass(story.category)]} data-category={story.category} data-search={`${story.title} ${story.summary} ${story.source} ${story.category}`.toLowerCase()}>
              <a class="card-media" href={storyHref(story)} aria-label={`Read ${story.title}`}>
                {story.image ? <img src={story.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class="card-fallback"><i class="ph ph-buildings"></i></div>}
                <span class="category-badge">{story.category}</span>
              </a>
              <div class="card-copy">
                <div class="story-meta">
                  <span class="source-dot" style={`--source-color:${story.source_accent}`}></span>
                  <span>{story.source}</span>
                  <span class="meta-separator">•</span>
                  <time datetime={story.published}>{published(story.published)}</time>
                </div>
                <h3><a href={storyHref(story)}>{story.title}</a></h3>
                {story.summary && <p>{story.summary}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="no-results shell" id="noResults" hidden>
      <div class="empty-icon"><i class="ph ph-magnifying-glass"></i></div>
      <h2>No matching stories</h2>
      <p>Try another search or category.</p>
    </section>
  </main>

  <script is:inline>
    const searchPanel = document.getElementById('searchPanel');
    const searchToggle = document.getElementById('searchToggle');
    const searchClose = document.getElementById('searchClose');
    const searchInput = document.getElementById('searchInput');
    const noResults = document.getElementById('noResults');
    let activeFilter = 'All';

    function openSearch() {
      if (!searchPanel) return;
      searchPanel.hidden = false;
      requestAnimationFrame(() => searchInput?.focus());
    }

    function closeSearch() {
      if (!searchPanel) return;
      searchPanel.hidden = true;
      if (searchInput) searchInput.value = '';
      applyFilters();
    }

    searchToggle?.addEventListener('click', openSearch);
    searchClose?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', applyFilters);

    document.querySelectorAll('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter || 'All';
        document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('active', item === button));
        applyFilters();
      });
    });

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visible = 0;
      document.querySelectorAll('.searchable').forEach((item) => {
        const categoryMatch = activeFilter === 'All' || item.dataset.category === activeFilter;
        const queryMatch = !query || (item.dataset.search || '').includes(query);
        const show = categoryMatch && queryMatch;
        item.classList.toggle('filtered-out', !show);
        if (show) visible += 1;
      });
      if (noResults) noResults.hidden = visible !== 0;
    }
  </script>
</BaseLayout>
