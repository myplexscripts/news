---
import BaseLayout from '../layouts/BaseLayout.astro';
import news from '../../data/news.json';

const stories = (news.stories || []).slice(0, 90);
const preferredCategoryOrder = ['Local', 'Public Safety', 'City Hall', 'Business', 'Traffic', 'Education', 'Health', 'Community', 'Sports'];
const discoveredCategories = Array.from(new Set(stories.map((story) => story.category).filter(Boolean)));
const orderedCategories = [
  ...preferredCategoryOrder.filter((category) => discoveredCategories.includes(category)),
  ...discoveredCategories.filter((category) => !preferredCategoryOrder.includes(category)).sort()
];
const primaryCategories = orderedCategories.slice(0, 4);
const moreCategories = orderedCategories.slice(4);
const base = import.meta.env.BASE_URL;

const storyHref = (story) => `${base}story/${story.id}/`;
const categoryClass = (category = 'Local') => `category-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const initials = (name = '') => name.split(/\s+/).filter(Boolean).map((part) => part[0]).slice(0, 2).join('').toUpperCase();

const published = (value) => {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const generated = news.generated_at
  ? new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      hour: 'numeric',
      minute: '2-digit'
    }).format(new Date(news.generated_at))
  : 'waiting for refresh';
---
<BaseLayout>
  <div slot="header-actions" class="header-search" id="headerSearch">
    <button class="header-search-toggle" id="searchToggle" aria-label="Search news" title="Search news" aria-expanded="false" aria-controls="searchInput">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
    </button>
    <input id="searchInput" type="search" placeholder="Search London News" autocomplete="off" aria-label="Search London News" />
    <button class="header-search-close" id="searchClose" aria-label="Close search" title="Close search">
      <i class="ph ph-x-circle" aria-hidden="true"></i>
    </button>
  </div>

  <main class="home-page card-home" id="main-content">
    <section class="home-intro shell">
      <div>
        <p class="masthead-label">London, Ontario</p>
        <h1>Latest local news</h1>
      </div>
      <p class="home-update">Updated {generated} <span aria-hidden="true">·</span> {stories.length} stories</p>
    </section>

    <section class="section-nav-wrap card-filter-wrap" aria-label="News filters">
      <div class="shell section-nav-inner card-filter-inner">
        <div class="section-tabs" role="group" aria-label="Filter by section">
          <button class="section-tab active" data-filter="All" aria-pressed="true">Latest</button>
          {primaryCategories.map((category) => (
            <button class:list={["section-tab", categoryClass(category)]} data-filter={category} aria-pressed="false">{category}</button>
          ))}
          {moreCategories.length > 0 && (
            <details class="control-menu" id="sectionMore">
              <summary>
                <span id="moreLabel">More</span>
                <i class="ph ph-caret-down" aria-hidden="true"></i>
              </summary>
              <div class="control-popover section-popover">
                {moreCategories.map((category) => (
                  <button class:list={["control-menu-item", categoryClass(category)]} data-filter={category}>
                    <span class="section-color" aria-hidden="true"></span>
                    <span>{category}</span>
                  </button>
                ))}
              </div>
            </details>
          )}
        </div>
        <a class="manage-sources-button" href={`${base}sources/`}>
          <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>
          <span>Sources</span>
        </a>
      </div>
    </section>

    <section class="news-card-section shell" id="latest" aria-labelledby="latest-heading">
      <header class="news-card-section-header">
        <h2 id="latest-heading" class="visually-hidden">Latest London news</h2>
        <p class="results-status" id="resultsStatus" aria-live="polite">Showing the latest London stories</p>
      </header>

      <div class="news-card-grid" id="newsCardGrid">
        {stories.map((story) => (
          <article
            class:list={["news-card", "searchable", categoryClass(story.category)]}
            data-category={story.category}
            data-source={story.source}
            data-search={`${story.title} ${story.summary || ''} ${story.source} ${story.category || ''}`.toLowerCase()}
          >
            <a class="news-card-media" href={storyHref(story)} aria-label={`Read ${story.title}`}>
              {story.image
                ? <img src={story.image} alt={story.image_alt || ''} loading="lazy" referrerpolicy="no-referrer" />
                : <div class="news-card-fallback"><i class="ph-fill ph-newspaper-clipping" aria-hidden="true"></i></div>}
            </a>
            <div class="news-card-body">
              <div class="news-card-source">
                <span class="news-source-avatar" style={`--source-color:${story.source_accent || 'var(--blue)'}`}>{initials(story.source)}</span>
                <strong>{story.source}</strong>
              </div>
              <span class="news-card-category">{story.category}</span>
              <h3><a href={storyHref(story)}>{story.title}</a></h3>
              {story.summary && <p class="news-card-summary">{story.summary}</p>}
              <div class="news-card-footer">
                <time datetime={story.published}>{published(story.published)}</time>
                {story.word_count && <span>{Math.max(1, Math.round(story.word_count / 220))} min read</span>}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="no-results card-no-results" id="noResults" hidden>
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <h2>No matching stories</h2>
        <p>Try another section or search term, or review your hidden sources.</p>
        <a class="bordered-button" href={`${base}sources/`}>Manage sources</a>
      </div>
    </section>
  </main>

  <script is:inline>
    const headerSearch = document.getElementById('headerSearch');
    const searchToggle = document.getElementById('searchToggle');
    const searchClose = document.getElementById('searchClose');
    const searchInput = document.getElementById('searchInput');
    const noResults = document.getElementById('noResults');
    const resultsStatus = document.getElementById('resultsStatus');
    const sectionMore = document.getElementById('sectionMore');
    const moreLabel = document.getElementById('moreLabel');
    const cards = [...document.querySelectorAll('.news-card.searchable')];

    let activeFilter = 'All';
    let hiddenSources = new Set();

    try {
      hiddenSources = new Set(JSON.parse(localStorage.getItem('london-news-hidden-sources') || '[]'));
    } catch {
      hiddenSources = new Set();
    }

    function openSearch() {
      headerSearch?.classList.add('is-open');
      searchToggle?.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => searchInput?.focus());
    }

    function closeSearch() {
      headerSearch?.classList.remove('is-open');
      searchToggle?.setAttribute('aria-expanded', 'false');
      if (searchInput) searchInput.value = '';
      applyFilters();
      searchToggle?.focus();
    }

    function setFilter(value) {
      activeFilter = value;
      document.querySelectorAll('.section-tab[data-filter]').forEach((item) => {
        const selected = item.dataset.filter === value;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      document.querySelectorAll('.control-menu-item[data-filter]').forEach((item) => item.classList.toggle('active-filter', item.dataset.filter === value));
      if (moreLabel) moreLabel.textContent = [...document.querySelectorAll('.control-menu-item[data-filter]')].some((item) => item.dataset.filter === value) ? value : 'More';
      sectionMore?.removeAttribute('open');
      applyFilters();
    }

    function assignCardLayouts(visibleCards) {
      cards.forEach((card) => card.classList.remove('card-featured', 'card-secondary', 'card-standard'));
      visibleCards.forEach((card, index) => {
        if (index === 0) card.classList.add('card-featured');
        else if (index <= 2) card.classList.add('card-secondary');
        else card.classList.add('card-standard');
      });
    }

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const visibleCards = [];

      cards.forEach((item) => {
        const categoryMatch = activeFilter === 'All' || item.dataset.category === activeFilter;
        const queryMatch = !query || (item.dataset.search || '').includes(query);
        const sourceMatch = !hiddenSources.has(item.dataset.source || '');
        const show = categoryMatch && queryMatch && sourceMatch;
        item.classList.toggle('filtered-out', !show);
        if (show) visibleCards.push(item);
      });

      assignCardLayouts(visibleCards);
      if (noResults) noResults.hidden = visibleCards.length !== 0;
      if (resultsStatus) {
        const qualifiers = [];
        if (activeFilter !== 'All') qualifiers.push(activeFilter);
        if (query) qualifiers.push(`“${query}”`);
        if (hiddenSources.size) qualifiers.push(`${hiddenSources.size} hidden ${hiddenSources.size === 1 ? 'source' : 'sources'}`);
        resultsStatus.textContent = visibleCards.length === 0
          ? 'No matching stories'
          : `${visibleCards.length} ${visibleCards.length === 1 ? 'story' : 'stories'}${qualifiers.length ? ` · ${qualifiers.join(' · ')}` : ''}`;
      }
    }

    searchToggle?.addEventListener('click', () => headerSearch?.classList.contains('is-open') ? searchInput?.focus() : openSearch());
    searchClose?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', applyFilters);
    searchInput?.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeSearch(); });
    document.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.filter || 'All')));

    document.addEventListener('click', (event) => {
      if (sectionMore?.hasAttribute('open') && !sectionMore.contains(event.target)) sectionMore.removeAttribute('open');
    });

    window.addEventListener('storage', (event) => {
      if (event.key !== 'london-news-hidden-sources') return;
      try { hiddenSources = new Set(JSON.parse(event.newValue || '[]')); } catch { hiddenSources = new Set(); }
      applyFilters();
    });

    applyFilters();
  </script>
</BaseLayout>
