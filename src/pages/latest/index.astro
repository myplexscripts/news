---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import PageHeading from '../../components/PageHeading.astro';
import news from '../../../data/news.json';
import { collapseTimelineStories } from '../../lib/timelineStories';

const base = import.meta.env.BASE_URL;
const storyTime = (story) => story.published;
const representatives = collapseTimelineStories(news.stories || []).slice(0, 140);
const storyIndex = new Map(representatives.map((story, index) => [story.id, index]));


const localDateKey = (value) => {
  try {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    }).formatToParts(new Date(value));
    const values = Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
    return `${values.year}-${values.month}-${values.day}`;
  } catch {
    return '1970-01-01';
  }
};
const dayNumber = (key) => {
  const [year, month, day] = key.split('-').map(Number);
  return Math.floor(Date.UTC(year, month - 1, day) / 86400000);
};
const referenceDay = dayNumber(localDateKey(news.generated_at || new Date().toISOString()));
const groupKeyFor = (value) => {
  const diff = referenceDay - dayNumber(localDateKey(value));
  if (diff <= 0) return 'today';
  if (diff === 1) return 'yesterday';
  if (diff === 2) return 'two-days-ago';
  return 'earlier';
};
const groupLabels = { today: 'Today', yesterday: 'Yesterday', 'two-days-ago': 'Two Days Ago', earlier: 'Earlier' };
const dateGroups = ['today', 'yesterday', 'two-days-ago', 'earlier']
  .map((key) => ({ key, label: groupLabels[key], stories: representatives.filter((story) => groupKeyFor(storyTime(story)) === key) }))
  .filter((group) => group.stories.length > 0);
---
<BaseLayout title="Latest | London News" description="The latest local news from London, Ontario in chronological order.">
  <div slot="header-actions" class="header-search" id="headerSearch">
    <button class="header-search-toggle" id="searchToggle" aria-label="Search latest news" title="Search" aria-expanded="false" aria-controls="searchInput">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
    </button>
    <input id="searchInput" type="search" placeholder="Search latest news" autocomplete="off" aria-label="Search latest news" />
    <button class="header-search-close" id="searchClose" aria-label="Close search" title="Close search">
      <i class="ph ph-x-circle" aria-hidden="true"></i>
    </button>
  </div>

  <main class="latest-page" id="main-content">
    <section class="latest-page-heading shell">
      <PageHeading eyebrow="Chronological" title="Latest" description="Every local story event, newest first." />
    </section>

    <section class="latest-page-feed shell" aria-labelledby="latest-feed-heading">
      <h2 id="latest-feed-heading" class="visually-hidden">Latest London stories</h2>
      <p class="results-status visually-hidden" id="resultsStatus" aria-live="polite">Newest stories shown first</p>
      <div class="latest-card-grid">
        {dateGroups.map((group) => (
          <>
            <header class="story-date-heading" data-date-heading={group.key}>
              <h2>{group.label}</h2>
            </header>
            {group.stories.map((story) => {
              const timestamp = storyTime(story);
              const index = storyIndex.get(story.id) ?? 99;
              return (
                <NewsCard
                  story={story}
                  index={index}
                  variant="standard"
                  searchable={true}
                  dateGroup={group.key}
                  dataSearch={`${story.title} ${story.summary || ''} ${(story.cluster_sources || [story.source]).join(' ')} ${story.category || ''}`.toLowerCase()}
                />
              );
            })}
          </>
        ))}
      </div>
      <div class="no-results card-no-results" id="noResults" hidden>
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <h2>No matching stories</h2>
        <p>Try another search or review your hidden sources.</p>
      </div>
    </section>
  </main>

  <script>
    import { initialiseUserState, onUserStateChange } from '../../lib/userState';

    const headerSearch = document.getElementById('headerSearch');
    const searchToggle = document.getElementById('searchToggle');
    const searchClose = document.getElementById('searchClose');
    const searchInput = document.getElementById('searchInput');
    const cards = [...document.querySelectorAll('.latest-card-grid .searchable')];
    const dateHeadings = [...document.querySelectorAll('[data-date-heading]')];
    const noResults = document.getElementById('noResults');
    const resultsStatus = document.getElementById('resultsStatus');
    let hiddenSources = new Set();
    let readStories = new Set();
    let hideReadStories = false;

    function applyUserState(state) {
      hiddenSources = new Set(state.hiddenSources || []);
      readStories = new Set((state.readIds || []).map(String));
      hideReadStories = Boolean(state.hideRead);
      applyLatestFilters();
    }

    function updateDateHeadings() {
      dateHeadings.forEach((heading) => {
        const key = heading.dataset.dateHeading;
        const hasVisibleStories = cards.some((card) => card.dataset.dateGroup === key && !card.classList.contains('filtered-out'));
        heading.hidden = !hasVisibleStories;
      });
    }

    function applyLatestFilters() {
      const query = (searchInput instanceof HTMLInputElement ? searchInput.value : '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const sources = (card.dataset.sources || card.dataset.source || '').split('|').filter(Boolean);
        const sourceMatch = sources.length === 0 || sources.some((source) => !hiddenSources.has(source));
        const searchMatch = !query || (card.dataset.search || '').includes(query);
        const readMatch = !hideReadStories || !readStories.has(String(card.dataset.storyId || ''));
        const show = sourceMatch && searchMatch && readMatch;
        card.classList.toggle('filtered-out', !show);
        if (show) visible += 1;
      });
      updateDateHeadings();
      if (noResults) noResults.hidden = visible !== 0;
      if (resultsStatus) resultsStatus.textContent = visible === 0 ? 'No matching stories' : 'Newest matching stories shown first';
    }

    function openSearch() {
      headerSearch?.classList.add('is-open');
      searchToggle?.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => searchInput?.focus());
    }

    function closeSearch() {
      headerSearch?.classList.remove('is-open');
      searchToggle?.setAttribute('aria-expanded', 'false');
      if (searchInput instanceof HTMLInputElement) searchInput.value = '';
      applyLatestFilters();
      searchToggle?.focus();
    }

    searchToggle?.addEventListener('click', () => headerSearch?.classList.contains('is-open') ? searchInput?.focus() : openSearch());
    searchClose?.addEventListener('click', closeSearch);
    searchInput?.addEventListener('input', applyLatestFilters);
    searchInput?.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeSearch(); });

    initialiseUserState().then(applyUserState).catch(() => {});
    onUserStateChange(applyUserState);
    applyLatestFilters();
  </script>
</BaseLayout>
