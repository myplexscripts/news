---
import BaseLayout from '../../layouts/BaseLayout.astro';
import news from '../../../data/news.json';
import { sourceLogoPath } from '../../lib/sourceLogos';
const stories = [...(news.stories || [])]
  .filter((story) => story.cluster_representative !== false)
  .sort((a,b) => new Date(b.cluster_latest_published || b.published).getTime() - new Date(a.cluster_latest_published || a.published).getTime());
const base = import.meta.env.BASE_URL;
const logoFor = (name = '') => sourceLogoPath(name, base);
const published = (value) => { try { return new Intl.DateTimeFormat('en-CA',{timeZone:'America/Toronto',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(new Date(value)); } catch { return ''; } };
---
<BaseLayout title="Search | London News" description="Search London News stories.">
  <main class="directory-page search-page" id="main-content">
    <section class="directory-shell shell">
      <header class="directory-heading">
        <p class="masthead-label">Find stories</p>
        <h1>Search</h1>
        <p>Search headlines, publishers, locations and article text from the current London News archive.</p>
      </header>

      <div class="search-page-field">
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <input id="archiveSearch" type="search" autocomplete="off" placeholder="Search London News" aria-label="Search London News" autofocus />
        <button id="clearArchiveSearch" class="search-clear-button" type="button" aria-label="Clear search" hidden><i class="ph ph-x-circle" aria-hidden="true"></i></button>
      </div>
      <p class="search-result-status" id="archiveSearchStatus" aria-live="polite">Start typing to search.</p>

      <div class="search-results" id="archiveSearchResults">
        {stories.map((story) => (
          <a class="search-result-card" href={`${base}story/${story.id}/`} data-story-id={story.id} data-search={`${story.title} ${story.summary || ''} ${story.source || ''} ${story.category || ''} ${(story.paragraphs || []).slice(0,4).join(' ')} ${(story.story_topics || []).join(' ')}`.toLowerCase()} hidden>
            {story.image && <div class="search-result-media"><img class="search-result-photo" src={story.card_image ? `${base}${story.card_image}` : story.image} alt={story.image_alt || ''} loading="lazy" referrerpolicy="no-referrer" />{logoFor(story.source) && <img class="card-source-logo" onerror="this.style.display='none'" src={logoFor(story.source)} alt="" loading="lazy" />}</div>}
            <div class="search-result-copy">
              <span>{story.source}</span>
              <h2>{story.title}</h2>
              <time datetime={story.cluster_latest_published || story.published}>{published(story.cluster_latest_published || story.published)}</time>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <script is:inline>
    const input = document.getElementById('archiveSearch');
    const clear = document.getElementById('clearArchiveSearch');
    const status = document.getElementById('archiveSearchStatus');
    const cards = [...document.querySelectorAll('.search-result-card')];
    let readStories = new Set();
    let hideReadStories = false;

    function loadReadingPreferences() {
      hideReadStories = localStorage.getItem('london-news-hide-read') === 'true';
      try {
        const ids = JSON.parse(localStorage.getItem('london-news-read-articles') || '[]');
        readStories = new Set(Array.isArray(ids) ? ids.map(String) : []);
      } catch {
        readStories = new Set();
      }
    }

    function update() {
      const q = (input?.value || '').trim().toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const matchesText = q.length >= 2 && (card.dataset.search || '').includes(q);
        const matchesReading = !hideReadStories || !readStories.has(String(card.dataset.storyId || ''));
        const yes = matchesText && matchesReading;
        card.hidden = !yes;
        if (yes) shown++;
      });
      if (clear) clear.hidden = !q;
      if (status) status.textContent = q.length < 2 ? 'Type at least 2 characters.' : `${shown} ${shown === 1 ? 'result' : 'results'}${hideReadStories ? ' · read stories hidden' : ''}`;
    }

    input?.addEventListener('input', update);
    clear?.addEventListener('click', () => { if (input) input.value=''; update(); input?.focus(); });
    window.addEventListener('storage', (event) => {
      if (!['london-news-read-articles', 'london-news-hide-read'].includes(event.key || '')) return;
      loadReadingPreferences();
      update();
    });
    window.addEventListener('london-news-read-state', (event) => {
      readStories = new Set((event.detail?.readIds || []).map(String));
      hideReadStories = Boolean(event.detail?.hideRead);
      update();
    });
    loadReadingPreferences();
    update();
  </script>
</BaseLayout>
