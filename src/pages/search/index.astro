---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import PageHeading from '../../components/PageHeading.astro';
import news from '../../../data/news.json';
const stories = [...(news.stories || [])]
  .sort((a,b) => new Date(b.cluster_latest_published || b.published).getTime() - new Date(a.cluster_latest_published || a.published).getTime());
const base = import.meta.env.BASE_URL;
const searchDocuments = stories.map((story) => ({
  id: String(story.id),
  title: story.title || '',
  summary: story.summary || '',
  source: story.source || '',
  category: story.category || '',
  topics: Array.isArray(story.story_topics) ? story.story_topics.join(' ') : '',
  body: Array.isArray(story.paragraphs) ? story.paragraphs.slice(0, 10).join(' ') : (story.content || '')
}));
const searchData = JSON.stringify(searchDocuments).replace(/</g, '\\u003c');
---
<BaseLayout title="Search | London News" description="Search London News stories.">
  <main class="directory-page search-page" id="main-content">
    <section class="directory-shell shell">
      <PageHeading className="directory-heading" eyebrow="Find stories" title="Search" description="Search headlines, publishers, locations and article text from the current London News archive." />

      <div class="search-page-field">
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <input id="archiveSearch" type="search" autocomplete="off" placeholder="Search London News" aria-label="Search London News" autofocus />
        <button id="clearArchiveSearch" class="search-clear-button" type="button" aria-label="Clear search" hidden><i class="ph ph-x-circle" aria-hidden="true"></i></button>
      </div>
      <p class="search-result-status" id="archiveSearchStatus" aria-live="polite">Start typing to search.</p>

      <div class="search-results" id="archiveSearchResults" hidden>
        {stories.map((story) => (
          <NewsCard story={story} variant="standard" hidden={true} className="search-result-item" />
        ))}
      </div>
      <script id="archiveSearchData" type="application/json" set:html={searchData}></script>
    </section>
  </main>
  <script>
    import MiniSearch from 'minisearch';
    import { initialiseUserState, onUserStateChange } from '../../lib/userState';

    const input = document.getElementById('archiveSearch');
    const clear = document.getElementById('clearArchiveSearch');
    const status = document.getElementById('archiveSearchStatus');
    const resultsContainer = document.getElementById('archiveSearchResults');
    const dataElement = document.getElementById('archiveSearchData');
    const cards = [...document.querySelectorAll('.search-result-item')];
    const cardsById = new Map(cards.map((card) => [String(card.dataset.storyId || ''), card]));
    let state = { readIds: [], hideRead: false, hiddenSources: [] };
    let documents = [];

    try {
      documents = JSON.parse(dataElement?.textContent || '[]');
    } catch {
      documents = [];
    }

    const miniSearch = new MiniSearch({
      fields: ['title', 'summary', 'source', 'category', 'topics', 'body'],
      storeFields: ['id'],
      searchOptions: {
        boost: { title: 5, source: 2.5, category: 2, topics: 2, summary: 1.7 },
        fuzzy: 0.2,
        prefix: true,
        combineWith: 'AND'
      }
    });
    miniSearch.addAll(documents);

    function update() {
      const q = (input instanceof HTMLInputElement ? input.value : '').trim();
      const readStories = new Set((state.readIds || []).map(String));
      const hiddenSources = new Set(state.hiddenSources || []);
      const hideReadStories = Boolean(state.hideRead);

      cards.forEach((card) => {
        card.hidden = true;
        card.style.order = '';
      });

      if (clear instanceof HTMLElement) clear.hidden = !q;
      if (q.length < 2) {
        if (resultsContainer instanceof HTMLElement) resultsContainer.hidden = true;
        if (status) status.textContent = q.length ? 'Type at least 2 characters.' : 'Start typing to search.';
        return;
      }

      if (resultsContainer instanceof HTMLElement) resultsContainer.hidden = false;
      const fuzzy = q.length >= 5 ? 0.22 : 0.12;
      const results = miniSearch.search(q, { fuzzy, prefix: true, combineWith: 'AND' });
      let shown = 0;
      results.forEach((result, index) => {
        const card = cardsById.get(String(result.id));
        if (!card) return;
        const source = String(card.dataset.source || '');
        if (hiddenSources.has(source)) return;
        if (hideReadStories && readStories.has(String(card.dataset.storyId || ''))) return;
        card.hidden = false;
        card.style.order = String(index);
        shown += 1;
      });

      if (status) {
        const qualifiers = [];
        if (hideReadStories) qualifiers.push('read stories hidden');
        if (hiddenSources.size) qualifiers.push(`${hiddenSources.size} hidden ${hiddenSources.size === 1 ? 'source' : 'sources'}`);
        status.textContent = `${shown} ${shown === 1 ? 'result' : 'results'}${qualifiers.length ? ` · ${qualifiers.join(' · ')}` : ''}`;
      }
    }

    input?.addEventListener('input', update);
    clear?.addEventListener('click', () => {
      if (input instanceof HTMLInputElement) input.value = '';
      update();
      input?.focus();
    });

    initialiseUserState().then((next) => {
      state = next;
      update();
    }).catch(update);
    onUserStateChange((next) => {
      state = next;
      update();
    });
    update();
  </script>

  <style is:global>
    .search-results[hidden],
    .search-result-item[hidden] {
      display: none !important;
    }
  </style>
</BaseLayout>
