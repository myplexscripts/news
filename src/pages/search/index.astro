---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Search | London News" description="Search London News stories.">
  <main class="directory-page search-page" id="main-content" data-base={base}>
    <section class="directory-shell shell">
      <PageHeading className="directory-heading" eyebrow="Find stories" title="Search" description="Search headlines, publishers, topics and article text without loading the full archive into the page." />

      <div class="search-page-field search-page-field-refined">
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <input id="archiveSearch" type="search" autocomplete="off" placeholder="Search London News" aria-label="Search London News" autofocus />
        <button id="clearArchiveSearch" class="search-clear-button" type="button" aria-label="Clear search" hidden><i class="ph ph-x-circle" aria-hidden="true"></i></button>
      </div>

      <div class="archive-search-controls" aria-label="Search filters">
        <div class="archive-scope-switch" role="group" aria-label="Search feed">
          <button type="button" class="active" data-search-scope="all" aria-pressed="true">All</button>
          <button type="button" data-search-scope="local" aria-pressed="false">Local</button>
          <button type="button" data-search-scope="canada" aria-pressed="false">Canada</button>
        </div>
        <label>
          <span>Section</span>
          <select id="searchCategory"><option value="">All sections</option></select>
        </label>
        <label>
          <span>Source</span>
          <select id="searchSource"><option value="">All sources</option></select>
        </label>
        <label>
          <span>Date</span>
          <select id="searchDate">
            <option value="">Any time</option>
            <option value="1">Past 24 hours</option>
            <option value="7">Past 7 days</option>
            <option value="30">Past 30 days</option>
            <option value="365">Past year</option>
          </select>
        </label>
      </div>

      <p class="search-result-status" id="archiveSearchStatus" aria-live="polite">Loading search index.</p>
      <div class="archive-search-results" id="archiveSearchResults" hidden></div>
      <div class="archive-search-more" id="archiveSearchMore" hidden>
        <button class="bordered-button" id="showMoreSearch" type="button">Show more</button>
      </div>
    </section>
  </main>

  <script>
    import MiniSearch from 'minisearch';
    import { initialiseUserState, onUserStateChange } from '../../lib/userState';

    const main = document.getElementById('main-content');
    const base = main?.dataset.base || '/';
    const input = document.getElementById('archiveSearch');
    const clear = document.getElementById('clearArchiveSearch');
    const status = document.getElementById('archiveSearchStatus');
    const resultsContainer = document.getElementById('archiveSearchResults');
    const moreWrap = document.getElementById('archiveSearchMore');
    const showMore = document.getElementById('showMoreSearch');
    const categorySelect = document.getElementById('searchCategory');
    const sourceSelect = document.getElementById('searchSource');
    const dateSelect = document.getElementById('searchDate');
    const scopeButtons = [...document.querySelectorAll('[data-search-scope]')];

    let documents = [];
    let documentsById = new Map();
    let miniSearch = null;
    let activeScope = 'all';
    let resultLimit = 30;
    let state = { readIds: [], hideRead: false, hiddenSources: [] };

    function resolveAsset(value = '') {
      const src = String(value || '').trim();
      if (!src) return '';
      if (/^https?:\/\//i.test(src) || src.startsWith('/')) return src;
      return `${base}${src}`;
    }

    function formatDate(value) {
      try {
        return new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Toronto',
          month: 'short',
          day: 'numeric',
          year: 'numeric'
        }).format(new Date(value));
      } catch {
        return '';
      }
    }

    function fillSelect(select, values) {
      if (!(select instanceof HTMLSelectElement)) return;
      const current = select.value;
      while (select.options.length > 1) select.remove(1);
      values.forEach((value) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.append(option);
      });
      select.value = values.includes(current) ? current : '';
    }

    function createResultCard(doc) {
      const article = document.createElement('article');
      article.className = 'archive-search-hit';
      article.dataset.storyId = String(doc.id || '');

      if (doc.image) {
        const imageLink = document.createElement('a');
        imageLink.className = 'archive-search-hit-image';
        imageLink.href = `${base}story/${encodeURIComponent(doc.id)}/`;
        imageLink.tabIndex = -1;
        const image = document.createElement('img');
        image.src = resolveAsset(doc.image);
        image.alt = '';
        image.loading = 'lazy';
        image.decoding = 'async';
        image.referrerPolicy = 'no-referrer';
        imageLink.append(image);
        article.append(imageLink);
      }

      const body = document.createElement('div');
      body.className = 'archive-search-hit-body';

      const meta = document.createElement('div');
      meta.className = 'archive-search-hit-meta';
      const source = document.createElement('span');
      source.textContent = doc.source || 'Unknown source';
      meta.append(source);
      if (doc.category) {
        const category = document.createElement('span');
        category.textContent = doc.category;
        meta.append(category);
      }
      body.append(meta);

      const heading = document.createElement('h2');
      const link = document.createElement('a');
      link.href = `${base}story/${encodeURIComponent(doc.id)}/`;
      link.textContent = doc.title || 'Untitled story';
      heading.append(link);
      body.append(heading);

      if (doc.summary) {
        const summary = document.createElement('p');
        summary.textContent = doc.summary;
        body.append(summary);
      }

      const footer = document.createElement('div');
      footer.className = 'archive-search-hit-footer';
      const published = document.createElement('time');
      published.dateTime = doc.published || '';
      published.textContent = formatDate(doc.published);
      footer.append(published);
      if (doc.readMinutes) {
        const readTime = document.createElement('span');
        readTime.textContent = `${doc.readMinutes} min read`;
        footer.append(readTime);
      }
      body.append(footer);
      article.append(body);
      return article;
    }

    function filteredResultIds(query) {
      if (!miniSearch) return [];
      const fuzzy = query.length >= 5 ? 0.22 : 0.12;
      const ranked = miniSearch.search(query, { fuzzy, prefix: true, combineWith: 'AND' });
      const readStories = new Set((state.readIds || []).map(String));
      const hiddenSources = new Set(state.hiddenSources || []);
      const category = categorySelect instanceof HTMLSelectElement ? categorySelect.value : '';
      const source = sourceSelect instanceof HTMLSelectElement ? sourceSelect.value : '';
      const days = dateSelect instanceof HTMLSelectElement ? Number(dateSelect.value || 0) : 0;
      const cutoff = days ? Date.now() - days * 86400000 : 0;

      return ranked.map((result) => String(result.id)).filter((id) => {
        const doc = documentsById.get(id);
        if (!doc) return false;
        if (activeScope !== 'all' && doc.scope !== activeScope) return false;
        if (category && doc.category !== category) return false;
        if (source && doc.source !== source) return false;
        if (hiddenSources.has(doc.source)) return false;
        if (state.hideRead && readStories.has(id)) return false;
        if (cutoff && Date.parse(doc.published || '') < cutoff) return false;
        return true;
      });
    }

    function update() {
      const query = input instanceof HTMLInputElement ? input.value.trim() : '';
      if (clear instanceof HTMLElement) clear.hidden = !query;

      if (!miniSearch) {
        if (status) status.textContent = 'Loading search index.';
        return;
      }

      if (query.length < 2) {
        if (resultsContainer instanceof HTMLElement) {
          resultsContainer.hidden = true;
          resultsContainer.replaceChildren();
        }
        if (moreWrap instanceof HTMLElement) moreWrap.hidden = true;
        if (status) status.textContent = query.length ? 'Type at least 2 characters.' : 'Start typing to search.';
        return;
      }

      const ids = filteredResultIds(query);
      const shownIds = ids.slice(0, resultLimit);
      if (resultsContainer instanceof HTMLElement) {
        resultsContainer.replaceChildren(...shownIds.map((id) => createResultCard(documentsById.get(id))));
        resultsContainer.hidden = shownIds.length === 0;
      }
      if (moreWrap instanceof HTMLElement) moreWrap.hidden = ids.length <= resultLimit;
      if (status) {
        status.textContent = ids.length
          ? `${ids.length} ${ids.length === 1 ? 'result' : 'results'}${ids.length > resultLimit ? `, showing ${resultLimit}` : ''}`
          : 'No matching stories.';
      }
    }

    function setScope(scope) {
      activeScope = ['all', 'local', 'canada'].includes(scope) ? scope : 'all';
      scopeButtons.forEach((button) => {
        const selected = button.dataset.searchScope === activeScope;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      resultLimit = 30;
      update();
    }

    async function loadSearchIndex() {
      try {
        const response = await fetch(`${base}data/search-index.json`, { cache: 'no-cache' });
        if (!response.ok) throw new Error(`Search index returned ${response.status}`);
        const payload = await response.json();
        documents = Array.isArray(payload.documents) ? payload.documents.map((doc) => ({
          ...doc,
          id: String(doc.id || ''),
          topicsText: Array.isArray(doc.topics) ? doc.topics.join(' ') : String(doc.topics || '')
        })) : [];
        documentsById = new Map(documents.map((doc) => [doc.id, doc]));
        miniSearch = new MiniSearch({
          fields: ['title', 'summary', 'source', 'category', 'topicsText', 'body'],
          storeFields: ['id'],
          searchOptions: {
            boost: { title: 5, source: 2.5, category: 2, topicsText: 2, summary: 1.7 },
            fuzzy: 0.2,
            prefix: true,
            combineWith: 'AND'
          }
        });
        miniSearch.addAll(documents);
        fillSelect(categorySelect, [...new Set(documents.map((doc) => doc.category).filter(Boolean))].sort());
        fillSelect(sourceSelect, [...new Set(documents.map((doc) => doc.source).filter(Boolean))].sort());
        update();
      } catch (error) {
        console.error(error);
        if (status) status.textContent = 'Search index could not be loaded. Try refreshing the page.';
      }
    }

    input?.addEventListener('input', () => { resultLimit = 30; update(); });
    clear?.addEventListener('click', () => {
      if (input instanceof HTMLInputElement) input.value = '';
      resultLimit = 30;
      update();
      input?.focus();
    });
    categorySelect?.addEventListener('change', () => { resultLimit = 30; update(); });
    sourceSelect?.addEventListener('change', () => { resultLimit = 30; update(); });
    dateSelect?.addEventListener('change', () => { resultLimit = 30; update(); });
    scopeButtons.forEach((button) => button.addEventListener('click', () => setScope(button.dataset.searchScope || 'all')));
    showMore?.addEventListener('click', () => { resultLimit += 30; update(); });

    initialiseUserState().then((next) => { state = next; update(); }).catch(() => {});
    onUserStateChange((next) => { state = next; update(); });
    loadSearchIndex();
  </script>

  <style is:global>
    .archive-search-controls {
      display: grid;
      grid-template-columns: auto repeat(3, minmax(150px, 1fr));
      gap: 12px;
      align-items: end;
      margin: 18px 0 12px;
    }

    .archive-search-controls label {
      display: grid;
      gap: 6px;
      color: var(--muted);
      font-size: 16px;
      font-weight: 600;
    }

    .archive-search-controls select {
      min-height: 44px;
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--surface);
      color: var(--text);
      padding: 0 38px 0 12px;
      font: inherit;
      font-size: 16px;
    }

    .archive-scope-switch {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      padding: 4px;
      min-height: 44px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface);
    }

    .archive-scope-switch button {
      min-width: 68px;
      min-height: 36px;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    .archive-scope-switch button.active {
      background: var(--accent-soft);
      color: var(--accent-ink);
    }

    .archive-search-results {
      display: grid;
      gap: 0;
      margin-top: 16px;
      border-top: 1px solid var(--line);
    }

    .archive-search-hit {
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 22px;
      padding: 22px 0;
      border-bottom: 1px solid var(--line);
    }

    .archive-search-hit-image {
      display: block;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 16px;
      background: var(--surface-2);
    }

    .archive-search-hit-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .archive-search-hit-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .archive-search-hit-meta,
    .archive-search-hit-footer {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      color: var(--muted);
      font-size: 16px;
    }

    .archive-search-hit-meta span + span::before,
    .archive-search-hit-footer > * + *::before {
      content: '·';
      margin-right: 10px;
    }

    .archive-search-hit h2 {
      margin: 7px 0 6px;
      font-size: clamp(20px, 2vw, 28px);
      line-height: 1.12;
    }

    .archive-search-hit h2 a {
      color: var(--text);
      text-decoration: none;
    }

    .archive-search-hit h2 a:hover {
      color: var(--accent);
    }

    .archive-search-hit p {
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .archive-search-more {
      display: flex;
      justify-content: center;
      padding: 22px 0;
    }

    @media (max-width: 820px) {
      .archive-search-controls {
        grid-template-columns: 1fr 1fr;
      }

      .archive-scope-switch {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 620px) {
      .archive-search-controls {
        grid-template-columns: 1fr;
      }

      .archive-search-hit {
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 14px;
      }

      .archive-search-hit p {
        display: none;
      }

      .archive-search-hit h2 {
        font-size: 19px;
      }
    }
  </style>
</BaseLayout>
