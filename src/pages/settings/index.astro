---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';

const accents = [
  ['red', 'Red'],
  ['orange', 'Orange'],
  ['yellow', 'Yellow'],
  ['green', 'Green'],
  ['mint', 'Mint'],
  ['teal', 'Teal'],
  ['cyan', 'Cyan'],
  ['blue', 'Blue'],
  ['indigo', 'Indigo'],
  ['purple', 'Purple'],
  ['pink', 'Pink'],
  ['brown', 'Brown']
];
---
<BaseLayout title="Settings | Forest City News" description="Customize Forest City News appearance and reading preferences.">
  <main class="settings-page" id="main-content">
    <section class="settings-shell shell">
      <PageHeading className="settings-heading directory-heading" eyebrow="Preferences" title="Settings" description="Choose how Forest City News looks and how stories behave on this device." />

      <div class="settings-groups">
        <section class="settings-group" aria-labelledby="appearance-heading">
          <h2 id="appearance-heading">Appearance</h2>
          <div class="settings-card">
            <div class="settings-row">
              <div class="settings-row-copy">
                <strong>Theme</strong>
                <span>Choose a light or dark reading experience.</span>
              </div>
              <div class="settings-segmented" aria-label="Theme">
                <button type="button" data-theme-choice="light">Light</button>
                <button type="button" data-theme-choice="dark">Dark</button>
              </div>
            </div>

            <div class="settings-accent-row">
              <div class="settings-row-copy">
                <strong>Accent colour</strong>
                <span>Used for controls, publisher names and interface highlights.</span>
              </div>
              <div class="accent-grid" aria-label="Accent colour">
                {accents.map(([key, label]) => (
                  <button
                    type="button"
                    class="accent-choice"
                    data-accent-choice={key}
                    aria-label={`${label} accent`}
                    title={label}
                    style={`--swatch: var(--${key})`}
                  >
                    <i class="ph ph-check" aria-hidden="true"></i>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="settings-group" aria-labelledby="reading-heading">
          <h2 id="reading-heading">Reading</h2>
          <div class="settings-card">
            <div class="settings-row settings-toggle-row">
              <div class="settings-row-copy">
                <strong>Hide read articles</strong>
                <span>Stories you open will disappear from article lists on this device.</span>
              </div>
              <label class="settings-switch">
                <input id="hideReadToggle" type="checkbox" aria-label="Hide read articles" />
                <span class="settings-switch-track" aria-hidden="true"></span>
              </label>
            </div>

            <div class="settings-row">
              <div class="settings-row-copy">
                <strong>Read history</strong>
                <span id="readHistoryStatus">No articles marked as read.</span>
              </div>
              <button class="settings-action-button" id="clearReadHistory" type="button">Clear history</button>
            </div>
          </div>
          <p class="settings-footnote">Reading history and these preferences are stored only in this browser. They are not tied to an account.</p>
        </section>

        <section class="settings-group" aria-labelledby="data-heading">
          <h2 id="data-heading">Data</h2>
          <div class="settings-card">
            <div class="settings-row">
              <div class="settings-row-copy">
                <strong>Clear all data</strong>
                <span>Reset preferences and remove read history, Read Later items and hidden sources from this device.</span>
              </div>
              <button class="settings-action-button" id="clearAllData" type="button">Clear all data</button>
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>

  <script>
    import { clearAllUserData, clearReadHistory, initialiseUserState, onUserStateChange, setPreference } from '../../lib/userState';

    const root = document.documentElement;
    const themeChoices = [...document.querySelectorAll('[data-theme-choice]')];
    const accentChoices = [...document.querySelectorAll('[data-accent-choice]')];
    const hideReadToggle = document.getElementById('hideReadToggle');
    const readHistoryStatus = document.getElementById('readHistoryStatus');
    const clearReadHistoryButton = document.getElementById('clearReadHistory');
    const clearAllDataButton = document.getElementById('clearAllData');

    function syncSettings(state) {
      const theme = state.theme || root.dataset.theme || 'light';
      const accent = state.accent || root.dataset.accent || 'green';
      const hideRead = Boolean(state.hideRead);
      const reads = Array.isArray(state.readIds) ? state.readIds : [];

      root.dataset.theme = theme;
      root.dataset.accent = accent;
      root.dataset.hideRead = hideRead ? 'true' : 'false';

      themeChoices.forEach((button) => {
        const selected = button.dataset.themeChoice === theme;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      accentChoices.forEach((button) => {
        const selected = button.dataset.accentChoice === accent;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });

      if (hideReadToggle instanceof HTMLInputElement) hideReadToggle.checked = hideRead;
      if (readHistoryStatus) {
        readHistoryStatus.textContent = reads.length
          ? `${reads.length} ${reads.length === 1 ? 'article' : 'articles'} marked as read on this device.`
          : 'No articles marked as read.';
      }
      if (clearReadHistoryButton instanceof HTMLButtonElement) clearReadHistoryButton.disabled = reads.length === 0;
    }

    themeChoices.forEach((button) => button.addEventListener('click', () => {
      const value = button.dataset.themeChoice;
      if (value !== 'light' && value !== 'dark') return;
      root.dataset.theme = value;
      setPreference('theme', value).catch(() => {});
    }));

    accentChoices.forEach((button) => button.addEventListener('click', () => {
      const value = button.dataset.accentChoice;
      if (!value) return;
      root.dataset.accent = value;
      setPreference('accent', value).catch(() => {});
    }));

    hideReadToggle?.addEventListener('change', () => {
      if (!(hideReadToggle instanceof HTMLInputElement)) return;
      root.dataset.hideRead = hideReadToggle.checked ? 'true' : 'false';
      setPreference('hideRead', hideReadToggle.checked).catch(() => {});
    });

    clearReadHistoryButton?.addEventListener('click', () => {
      clearReadHistory().catch(() => {});
    });

    clearAllDataButton?.addEventListener('click', async () => {
      if (!(clearAllDataButton instanceof HTMLButtonElement)) return;
      const confirmed = window.confirm('Clear all Forest City News data from this device? This cannot be undone.');
      if (!confirmed) return;

      clearAllDataButton.disabled = true;
      try {
        await clearAllUserData();
        window.location.reload();
      } catch {
        clearAllDataButton.disabled = false;
      }
    });

    initialiseUserState().then(syncSettings).catch(() => {});
    onUserStateChange(syncSettings);
  </script>
</BaseLayout>

<style is:global>
  .settings-page .accent-choice,
  html[data-theme='dark'] .settings-page .accent-choice {
    width: 48px !important;
    min-width: 48px !important;
    max-width: 48px !important;
    height: 48px !important;
    min-height: 48px !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 50% !important;
    background: var(--swatch) !important;
    box-shadow: none !important;
    display: grid !important;
    place-items: center !important;
    justify-self: center !important;
    aspect-ratio: 1 / 1;
  }

  .settings-page .accent-choice::before,
  .settings-page .accent-choice::after {
    content: none !important;
    display: none !important;
  }

  .settings-page .accent-choice i {
    opacity: 0;
    color: #000 !important;
    font-size: 22px !important;
    font-weight: 700;
    transition: opacity 160ms ease, transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
    transform: scale(0.8);
  }

  .settings-page .accent-choice.selected,
  html[data-theme='dark'] .settings-page .accent-choice.selected {
    outline: 0 !important;
    box-shadow:
      0 0 0 3px var(--surface),
      0 0 0 5px var(--swatch) !important;
  }

  .settings-page .accent-choice.selected i {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 760px) {
    .settings-page .accent-grid {
      display: grid !important;
      grid-template-columns: repeat(6, minmax(44px, 1fr)) !important;
      grid-template-rows: repeat(2, 48px) !important;
      gap: 14px 8px !important;
      width: 100% !important;
      align-items: center !important;
      justify-items: center !important;
    }

    .settings-page .accent-choice,
    html[data-theme='dark'] .settings-page .accent-choice {
      width: 44px !important;
      min-width: 44px !important;
      max-width: 44px !important;
      height: 44px !important;
      min-height: 44px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .settings-page .accent-choice i {
      transition: none !important;
    }
  }
</style>