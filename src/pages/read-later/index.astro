---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Read Later | London News" description="Articles saved to read later on this device." noindex={true}>
  <main class="read-later-page" id="main-content" data-base={base}>
    <section class="read-later-shell shell">
      <PageHeading eyebrow="Saved" title="Read Later" description="Articles you bookmark are saved on this device until you remove them." />

      <p class="read-later-status" id="readLaterStatus" aria-live="polite">Loading saved articles…</p>

      <div class="read-later-grid" id="readLaterGrid" aria-label="Saved articles" hidden></div>

      <div class="read-later-empty" id="readLaterEmpty">
        <i class="ph ph-bookmark-simple" aria-hidden="true"></i>
        <h2>Nothing saved yet</h2>
        <p>Tap the bookmark on any article to keep it here for later.</p>
      </div>
    </section>
  </main>

  <script>
    import { initialiseUserState, onUserStateChange } from '../../lib/userState';

    const main = document.getElementById('main-content');
    const base = main?.dataset.base || '/';
    const grid = document.getElementById('readLaterGrid');
    const empty = document.getElementById('readLaterEmpty');
    const status = document.getElementById('readLaterStatus');
    let cardsById = null;
    let cardIndexPromise = null;

    function resolveAsset(value = '') {
      const src = String(value || '').trim();
      if (!src) return '';
      if (/^https?:\/\//i.test(src) || src.startsWith('/')) return src;
      return `${base}${src}`;
    }

    function formatDate(value) {
      try {
        return new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Toronto',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit'
        }).format(new Date(value));
      } catch {
        return '';
      }
    }

    function shortTitle(value = '') {
      const words = String(value || '').trim().split(/\s+/).filter(Boolean);
      return words.length > 20 ? `${words.slice(0, 20).join(' ')}...` : words.join(' ');
    }

    async function loadCardIndex() {
      if (cardsById) return cardsById;
      if (!cardIndexPromise) {
        cardIndexPromise = fetch(`${base}data/story-card-index.json`, { cache: 'force-cache' })
          .then((response) => {
            if (!response.ok) throw new Error(`Story card index returned ${response.status}`);
            return response.json();
          })
          .then((payload) => {
            const cards = Array.isArray(payload.cards) ? payload.cards : [];
            cardsById = new Map(cards.map((card) => [String(card.id || ''), card]));
            return cardsById;
          });
      }
      return cardIndexPromise;
    }

    function createSavedCard(story, isRead) {
      const article = document.createElement('article');
      article.className = 'news-card card-standard read-later-card is-saved-story';
      article.dataset.storyId = String(story.id || '');
      article.dataset.category = story.category || 'Local';
      article.dataset.source = story.source || '';
      article.classList.toggle('is-read-story', isRead);

      const link = document.createElement('a');
      link.className = 'news-card-link';
      link.href = `${base}story/${encodeURIComponent(story.id)}/`;
      link.setAttribute('aria-label', story.title || 'Saved story');
      article.append(link);

      const imageSrc = resolveAsset(story.image);
      if (imageSrc) {
        const media = document.createElement('div');
        media.className = 'news-card-media';
        const image = document.createElement('img');
        image.className = 'news-card-photo';
        image.src = imageSrc;
        image.alt = story.imageAlt || '';
        image.width = 420;
        image.height = 420;
        image.loading = 'lazy';
        image.decoding = 'async';
        image.referrerPolicy = 'no-referrer';
        media.append(image);
        article.append(media);
      } else {
        article.classList.add('no-image');
      }

      const body = document.createElement('div');
      body.className = 'news-card-body';

      if (story.source) {
        const source = document.createElement('span');
        source.className = 'card-source-name';
        source.textContent = story.source;
        body.append(source);
      }

      const heading = document.createElement('h3');
      heading.title = story.title || '';
      heading.textContent = shortTitle(story.title || 'Untitled story');
      body.append(heading);

      const footer = document.createElement('div');
      footer.className = 'news-card-footer';
      const time = document.createElement('time');
      time.dateTime = story.published || '';
      time.textContent = formatDate(story.published);
      footer.append(time);
      if (story.readMinutes) {
        const readTime = document.createElement('span');
        readTime.textContent = `${story.readMinutes} min read`;
        footer.append(readTime);
      }
      body.append(footer);

      if (story.summary) {
        const summary = document.createElement('p');
        summary.className = 'news-card-summary';
        summary.textContent = story.summary;
        body.append(summary);
      }

      const button = document.createElement('button');
      button.className = 'news-card-save is-saved';
      button.type = 'button';
      button.dataset.readLaterToggle = String(story.id || '');
      button.setAttribute('aria-label', 'Remove from Read Later');
      button.setAttribute('aria-pressed', 'true');
      button.setAttribute('title', 'Remove from Read Later');
      button.innerHTML = '<i class="ph-fill ph-bookmark-simple" aria-hidden="true"></i>';
      body.append(button);

      article.append(body);
      return article;
    }

    async function applySavedState(state) {
      if (!grid) return;

      const savedIds = (state.savedIds || []).map(String);
      const readSet = new Set((state.readIds || []).map(String));

      if (!savedIds.length) {
        grid.replaceChildren();
        grid.hidden = true;
        if (empty) empty.hidden = false;
        if (status) status.textContent = 'No saved articles';
        return;
      }

      if (status) status.textContent = 'Loading saved articles...';

      const index = await loadCardIndex();
      const fragment = document.createDocumentFragment();
      let available = 0;

      savedIds.forEach((id) => {
        const story = index.get(id);
        if (!story) return;
        fragment.append(createSavedCard(story, readSet.has(id)));
        available += 1;
      });

      grid.replaceChildren(fragment);
      grid.hidden = available === 0;

      const unavailable = Math.max(0, savedIds.length - available);
      if (empty) empty.hidden = available !== 0;
      if (status) {
        if (available === 0 && unavailable === 0) status.textContent = 'No saved articles';
        else if (unavailable > 0) status.textContent = `${available} saved ${available === 1 ? 'article' : 'articles'} shown · ${unavailable} no longer in the current archive`;
        else status.textContent = `${available} saved ${available === 1 ? 'article' : 'articles'}`;
      }
    }

    initialiseUserState().then(applySavedState).catch(() => {
      if (grid) grid.hidden = true;
      if (empty) empty.hidden = false;
      if (status) status.textContent = 'Saved articles could not be loaded';
    });
    onUserStateChange(applySavedState);
  </script>

  <style is:global>
    .read-later-page {
      padding-bottom: 80px;
    }

    .read-later-shell {
      padding-top: 34px;
    }

    .read-later-status {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: 16px;
      font-weight: 600;
    }

    .read-later-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .read-later-grid[hidden],
    .read-later-empty[hidden] {
      display: none !important;
    }

    html[data-hide-read='true'] .read-later-page .news-card.is-read-story {
      display: grid !important;
    }

    .read-later-empty {
      min-height: 260px;
      display: grid;
      place-items: center;
      align-content: center;
      gap: 8px;
      padding: 36px 20px;
      border-radius: 24px;
      background: var(--surface-subtle);
      text-align: center;
    }

    .read-later-empty > i {
      color: var(--accent);
      font-size: 34px;
    }

    .read-later-empty h2,
    .read-later-empty p {
      margin: 0;
    }

    .read-later-empty h2 {
      font-size: 24px;
    }

    .read-later-empty p {
      max-width: 420px;
      color: var(--muted);
      font-size: 16px;
    }

    @media (max-width: 760px) {
      .read-later-shell {
        padding-top: 18px;
      }

      .read-later-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
      }
    }
  </style>
</BaseLayout>
