---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { sourceLogoPath } from '../../lib/sourceLogos';
import news from '../../../data/news.json';

export function getStaticPaths() {
  return (news.stories || []).map((story) => ({
    params: { id: story.id },
    props: { story }
  }));
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const logoFor = (name = '') => sourceLogoPath(name, base);
const resolveImageSrc = (value = '') => {
  const src = String(value || '').trim();
  if (!src) return '';
  if (/^https?:\/\//i.test(src) || src.startsWith('/')) return src;
  return `${base}${src}`;
};
const heroImage = resolveImageSrc(story.card_image || story.image);

const published = (value) => {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const categoryClass = `category-${(story.category || 'Local').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const clusterMembers = story.cluster_id
  ? (news.stories || [])
      .filter((item) => item.cluster_id === story.cluster_id)
      .sort((a, b) => (Number(b.quality?.score) || 0) - (Number(a.quality?.score) || 0))
  : [story];
const clusterCoverage = clusterMembers.filter((item) => item.id !== story.id);
const related = (news.stories || [])
  .filter((item) => item.id !== story.id && item.cluster_id !== story.cluster_id && item.cluster_representative !== false && (item.category === story.category || item.source === story.source))
  .slice(0, 4);

const legacyParagraphs = Array.isArray(story.paragraphs) && story.paragraphs.length
  ? story.paragraphs
  : (story.content ? story.content.split(/\n+/).filter(Boolean) : story.summary ? [story.summary] : []);

const contentBlocks = Array.isArray(story.content_blocks) && story.content_blocks.length
  ? story.content_blocks
  : legacyParagraphs.map((text) => ({ type: 'paragraph', text }));

const qualityScore = story.quality?.score ?? (story.content_status === 'full' ? 70 : 40);
const extractionUsable = contentBlocks.length > 0 && !['failed', 'summary'].includes(story.content_status) && qualityScore >= 45;
const readerBlocks = extractionUsable
  ? contentBlocks
  : story.summary ? [{ type: 'paragraph', text: story.summary }] : contentBlocks;

const firstTextBlock = readerBlocks.find((block) => ['paragraph', 'quote'].includes(block.type) && block.text);
const readerWordCount = Number(story.word_count) || readerBlocks.reduce((total, block) => {
  const text = block.text || (Array.isArray(block.items) ? block.items.join(' ') : '');
  return total + String(text || '').trim().split(/\s+/).filter(Boolean).length;
}, 0);
const readMinutes = readerWordCount > 0 ? Math.max(1, Math.round(readerWordCount / 220)) : null;
const sidebarTagKeys = new Set();
const sidebarTags = [story.category, ...(Array.isArray(story.story_topics) ? story.story_topics : [])]
  .map((tag) => String(tag || '').trim())
  .filter((tag) => {
    if (!tag) return false;
    const key = tag.toLowerCase().replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
    if (key === 'full story' || sidebarTagKeys.has(key)) return false;
    sidebarTagKeys.add(key);
    return true;
  });

const compareKey = (value = '') => String(value)
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

const nearDuplicate = (left = '', right = '') => {
  const a = compareKey(left);
  const b = compareKey(right);
  if (!a || !b) return false;
  if (a === b) return true;
  const shorter = a.length <= b.length ? a : b;
  const longer = a.length <= b.length ? b : a;
  return shorter.length >= 28 && longer.startsWith(shorter) && shorter.length / longer.length >= 0.58;
};

const normalizeImageKey = (value = '') => {
  try {
    const url = new URL(value);
    return `${url.hostname}${url.pathname}`.toLowerCase().replace(/\/$/, '');
  } catch {
    return String(value).split('?')[0].toLowerCase().replace(/\/$/, '');
  }
};

const heroKey = normalizeImageKey(story.image || '');
const seenImages = new Set(heroKey ? [heroKey] : []);
const filteredReaderBlocks = readerBlocks.filter((block) => {
  if (block.type !== 'image' || !block.url) return true;
  const key = normalizeImageKey(block.url);
  if (!key || seenImages.has(key)) return false;
  seenImages.add(key);
  return true;
});

const showDeck = Boolean(
  story.summary &&
  !nearDuplicate(story.summary, story.title) &&
  !(firstTextBlock?.text && nearDuplicate(story.summary, firstTextBlock.text))
);

---
<BaseLayout title={`${story.title} | London News`} description={story.summary || `Local reporting from ${story.source}.`}>
  <main class:list={["article-page", categoryClass]} id="main-content" data-current-story-id={story.id}>
    <div class="article-shell shell article-shell-refined">
      <article class="article-layout article-layout-refined">
        <header class="article-header article-header-refined">
          <h1>{story.title}</h1>
          {showDeck && <p class="article-deck">{story.summary}</p>}
        </header>

        <aside class="article-sidebar article-sidebar-refined" aria-label="Article source and details">
          <div class="article-sidebar-sticky">
            <div class="article-source-card article-source-card-refined">
              <div class="source-card-identity">
                {logoFor(story.source) && <img class="source-card-logo" onerror="this.style.display='none'" src={logoFor(story.source)} alt="" /> }
                <div>
                  <span class="source-card-label">Published by</span>
                  <h2>{story.source}</h2>
                </div>
              </div>
              <div class="source-card-details">
                {story.author && <span>By {story.author}</span>}
                <time datetime={story.published}>{published(story.published)}</time>
              </div>
              {Number(story.cluster_source_count || 1) > 1 && (
                <div class="source-coverage">
                  <span class="source-card-label">Also covered by</span>
                  <div class="source-coverage-links">
                    {clusterCoverage.slice(0, 5).map((item) => (
                      <a href={`${base}story/${item.id}/`}>
                        <span>{item.source}</span>
                        <i class="ph ph-arrow-right" aria-hidden="true"></i>
                      </a>
                    ))}
                  </div>
                </div>
              )}
              <a class="source-original-link" href={story.url} target="_blank" rel="noopener noreferrer">Original article <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
            </div>
            {(readMinutes || sidebarTags.length > 0) && (
              <div class="article-sidebar-details">
                {readMinutes && (
                  <div class="article-sidebar-readtime">
                    <i class="ph ph-clock" aria-hidden="true"></i>
                    <span>{readMinutes} min read</span>
                  </div>
                )}
                {sidebarTags.length > 0 && (
                  <div class="article-sidebar-tags" aria-label="Story categories and tags">
                    {sidebarTags.map((tag) => <span>{tag}</span>)}
                  </div>
                )}
              </div>
            )}
          </div>
        </aside>

        {heroImage && (
          <figure class="article-hero article-hero-refined">
            <img src={heroImage} alt={story.image_alt || ''} referrerpolicy="no-referrer" />
          </figure>
        )}

        <div class="article-reader article-reader-refined">
          {filteredReaderBlocks.length ? (
            <div class="article-copy article-copy-refined">
              {filteredReaderBlocks.map((block) => (
                <>
                  {block.type === 'paragraph' && block.text && <p>{block.text}</p>}
                  {block.type === 'heading' && block.text && block.level === 3 && <h3>{block.text}</h3>}
                  {block.type === 'heading' && block.text && block.level !== 3 && <h2>{block.text}</h2>}
                  {block.type === 'quote' && block.text && <blockquote>{block.text}</blockquote>}
                  {block.type === 'list' && block.ordered && <ol>{(block.items || []).map((item) => <li>{item}</li>)}</ol>}
                  {block.type === 'list' && !block.ordered && <ul>{(block.items || []).map((item) => <li>{item}</li>)}</ul>}
                  {block.type === 'image' && block.url && (
                    <figure class="inline-article-image">
                      <img src={resolveImageSrc(block.url)} alt={block.alt || ''} loading="lazy" referrerpolicy="no-referrer" />
                      {block.caption && <figcaption>{block.caption}</figcaption>}
                    </figure>
                  )}
                </>
              ))}
            </div>
          ) : (
            <div class="article-copy article-copy-refined"><p>No readable article body was returned by this source.</p></div>
          )}
        </div>
      </article>

      {related.length > 0 && (
        <section class="related-section related-section-refined" id="relatedStoriesSection">
          <header class="editorial-section-heading">
            <div>
              <p class="section-eyebrow">Keep reading</p>
              <h2>More from London</h2>
            </div>
          </header>
          <div class="related-grid">
            {related.map((item) => <NewsCard story={item} variant="standard" />)}
          </div>
        </section>
      )}
    </div>
  </main>

  <script>
    import { markStoryRead } from '../../lib/userState';

    const articlePage = document.querySelector('[data-current-story-id]');
    const currentStoryId = String(articlePage?.dataset.currentStoryId || '');
    const relatedSection = document.getElementById('relatedStoriesSection');

    function markCurrentStoryRead() {
      if (!currentStoryId) return;
      markStoryRead(currentStoryId).catch(() => {});
    }

    function syncRelatedVisibility() {
      if (!relatedSection) return;
      const cards = [...relatedSection.querySelectorAll('[data-story-id]')];
      const hideRead = document.documentElement.dataset.hideRead === 'true';
      const hasVisible = cards.some((card) => !hideRead || !card.classList.contains('is-read-story'));
      relatedSection.hidden = !hasVisible;
    }

    window.addEventListener('london-news-read-state', syncRelatedVisibility);

    let readTimer = 0;
    function scheduleReadMark() {
      if (!currentStoryId || readTimer || document.visibilityState !== 'visible') return;
      readTimer = window.setTimeout(() => {
        readTimer = 0;
        if (document.visibilityState === 'visible') markCurrentStoryRead();
      }, 1200);
    }

    document.addEventListener('visibilitychange', scheduleReadMark);
    scheduleReadMark();
  </script>
</BaseLayout>
