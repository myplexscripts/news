---
import { sourceLogoPath } from '../lib/sourceLogos';

interface Props {
  story: any;
  variant?: 'featured' | 'standard';
  index?: number;
  href?: string;
  searchable?: boolean;
  hidden?: boolean;
  dateGroup?: string;
  dataSearch?: string;
  className?: string;
  showSummary?: boolean;
}

const {
  story,
  variant = 'standard',
  index = 99,
  href,
  searchable = false,
  hidden = false,
  dateGroup,
  dataSearch,
  className = '',
  showSummary = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const storyHref = href || `${base}story/${story.id}/`;
const logoFor = (name = '') => sourceLogoPath(name, base);
const timestamp = story.cluster_latest_published || story.published;
const categoryClass = `category-${String(story.category || 'Local').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const words = String(story.title || '').trim().split(/\s+/).filter(Boolean);
const title = words.length > 20 ? `${words.slice(0, 20).join(' ')}…` : words.join(' ');
const imageSrc = (() => {
  const value = String(variant === 'standard' ? (story.card_image_small || story.card_image || story.image || '') : (story.card_image || story.image || '')).trim();
  if (!value) return '';
  if (/^https?:\/\//i.test(value) || value.startsWith('/')) return value;
  return `${base}${value}`;
})();
const published = (value) => {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    }).format(new Date(value));
  } catch {
    return '';
  }
};
const readMinutes = Number(story.word_count) > 0 ? Math.max(1, Math.round(Number(story.word_count) / 220)) : null;
const clusterSources = Array.isArray(story.cluster_sources) && story.cluster_sources.length ? story.cluster_sources : [story.source].filter(Boolean);
---
<a
  class:list={[
    'news-card',
    `card-${variant}`,
    searchable && 'searchable',
    categoryClass,
    !imageSrc && 'no-image',
    className
  ]}
  href={storyHref}
  data-story-id={story.id}
  data-category={story.category}
  data-source={story.source}
  data-sources={clusterSources.join('|')}
  data-date-group={dateGroup}
  data-search={dataSearch}
  hidden={hidden}
>
  {imageSrc && (
    <div class="news-card-media">
      <img
        class="news-card-photo"
        src={imageSrc}
        alt={story.image_alt || ''}
        width={variant === 'standard' ? 420 : 720}
        height={variant === 'standard' ? 420 : 720}
        loading={index < 3 ? 'eager' : 'lazy'}
        fetchpriority={index < 3 ? 'high' : 'auto'}
        decoding="async"
        referrerpolicy="no-referrer"
        style={`--focus-x:${story.image_focus_x ?? 50}%;--focus-y:${story.image_focus_y ?? 50}%`}
      />
      {logoFor(story.source) && (
        <img
          class="card-source-logo"
          onerror="this.style.display='none'"
          src={logoFor(story.source)}
          alt=""
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  )}
  <div class="news-card-body">
    <h3 title={story.title}>{title}</h3>
    <div class="news-card-footer">
      <strong class="news-card-footer-source">{story.source}</strong>
      <time datetime={timestamp}>{published(timestamp)}</time>
      {readMinutes && <span>{readMinutes} min read</span>}
    </div>
    {showSummary && story.summary && <p class="news-card-summary">{story.summary}</p>}
  </div>
</a>

<script>
  function initialiseSourceLogoSizing() {
    const logos = [...document.querySelectorAll('.card-source-logo')];

    logos.forEach((item) => {
      if (!(item instanceof HTMLImageElement)) return;

      const classify = () => {
        if (!item.naturalWidth || !item.naturalHeight) return;
        const isLandscape = item.naturalWidth > item.naturalHeight;
        item.classList.toggle('is-landscape-logo', isLandscape);
        item.classList.toggle('is-portrait-logo', !isLandscape);
      };

      if (item.complete) classify();
      else item.addEventListener('load', classify, { once: true });
    });
  }

  function initialiseHomeCardLookahead() {
    const home = document.querySelector('.home-page');
    if (!home) return;

    const cards = [...home.querySelectorAll('.news-card')];
    if (!cards.length) return;

    const warmed = new Set();
    const warmNextThree = (startIndex) => {
      let remaining = 3;
      for (let index = Math.max(3, startIndex); index < cards.length && remaining > 0; index += 1) {
        const image = cards[index].querySelector('.news-card-photo');
        if (!(image instanceof HTMLImageElement)) continue;
        const src = image.currentSrc || image.src;
        if (!src) continue;
        if (image.complete || warmed.has(src)) {
          remaining -= 1;
          continue;
        }
        const preload = new Image();
        preload.decoding = 'async';
        preload.fetchPriority = 'low';
        preload.src = src;
        warmed.add(src);
        remaining -= 1;
      }
    };

    warmNextThree(3);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const index = cards.indexOf(entry.target);
        if (index >= 0) warmNextThree(index + 1);
      }
    }, { rootMargin: '75% 0px 75% 0px', threshold: 0.01 });

    cards.forEach((card) => observer.observe(card));
  }

  function initialiseNewsCards() {
    initialiseSourceLogoSizing();
    initialiseHomeCardLookahead();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseNewsCards, { once: true });
  } else {
    initialiseNewsCards();
  }
</script>
