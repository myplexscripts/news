---
import { sourceLogoPath } from '../lib/sourceLogos';

interface Props {
  story: any;
  variant?: 'featured' | 'standard';
  index?: number;
  href?: string;
  searchable?: boolean;
  hidden?: boolean;
  dateGroup?: string;
  dataSearch?: string;
  className?: string;
  showSummary?: boolean;
}

const {
  story,
  variant = 'standard',
  index = 99,
  href,
  searchable = false,
  hidden = false,
  dateGroup,
  dataSearch,
  className = '',
  showSummary = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const storyHref = href || `${base}story/${story.id}/`;
const logoFor = (name = '') => sourceLogoPath(name, base);
const sourceLogo = logoFor(story.source);
const timestamp = story.cluster_latest_published || story.published;
const categoryClass = `category-${String(story.category || 'Local').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const words = String(story.title || '').trim().split(/\s+/).filter(Boolean);
const title = words.length > 20 ? `${words.slice(0, 20).join(' ')}…` : words.join(' ');
const toImageSrc = (value) => {
  const clean = String(value || '').trim();
  if (!clean) return '';
  if (/^https?:\/\//i.test(clean) || clean.startsWith('/')) return clean;
  return `${base}${clean}`;
};
const rawImageCandidates = variant === 'standard'
  ? [story.card_image_small, story.card_image, story.image]
  : [story.card_image, story.image, story.card_image_small];
const imageCandidates = [...new Set(rawImageCandidates.map(toImageSrc).filter(Boolean))];
const imageSrc = imageCandidates[0] || '';
const imageFallbacks = imageCandidates.slice(1);
const published = (value) => {
  try {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    }).format(new Date(value));
  } catch {
    return '';
  }
};
const readMinutes = Number(story.word_count) > 0 ? Math.max(1, Math.round(Number(story.word_count) / 220)) : null;
const clusterSources = Array.isArray(story.cluster_sources) && story.cluster_sources.length ? story.cluster_sources : [story.source].filter(Boolean);
const sourceCount = Math.max(Number(story.cluster_source_count || 0), clusterSources.length || 1);
---
<article
  class:list={[
    'news-card',
    `card-${variant}`,
    searchable && 'searchable',
    categoryClass,
    !imageSrc && 'no-image',
    className
  ]}
  data-story-id={story.id}
  data-category={story.category}
  data-source={story.source}
  data-sources={clusterSources.join('|')}
  data-scope={story.scope || 'local'}
  data-date-group={dateGroup}
  data-search={dataSearch}
  hidden={hidden}
>
  <a class="news-card-link" href={storyHref} aria-label={story.title}></a>
  {imageSrc && (
    <div class="news-card-media">
      {variant === 'featured' && (
        <img
          class="news-card-photo-backdrop"
          src={imageSrc}
          alt=""
          aria-hidden="true"
          width="1200"
          height="675"
          loading={index < 3 ? 'eager' : 'lazy'}
          fetchpriority={index < 3 ? 'high' : 'auto'}
          decoding="async"
          referrerpolicy="no-referrer"
        />
      )}
      <img
        class="news-card-photo"
        src={imageSrc}
        data-image-fallbacks={JSON.stringify(imageFallbacks)}
        alt={story.image_alt || ''}
        width={variant === 'standard' ? 420 : 1200}
        height={variant === 'standard' ? 420 : 675}
        loading={index < 3 ? 'eager' : 'lazy'}
        fetchpriority={index < 3 ? 'high' : 'auto'}
        decoding="async"
        referrerpolicy="no-referrer"
        style={`--focus-x:${story.image_focus_x ?? 50}%;--focus-y:${story.image_focus_y ?? 50}%`}
      />
    </div>
  )}
  <div class="news-card-body">
    {sourceLogo && variant === 'featured' ? (
      <span class="card-source-mark-slot">
        <img
          class="card-source-mark"
          onerror="this.parentElement.style.display='none';this.parentElement.nextElementSibling?.removeAttribute('hidden')"
          src={sourceLogo}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </span>
    ) : sourceLogo && (
      <img
        class="card-source-mark"
        onerror="this.style.display='none';this.nextElementSibling?.removeAttribute('hidden')"
        src={sourceLogo}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
    {story.source && <span class="card-source-name" hidden={Boolean(sourceLogo)}>{story.source}</span>}
    <h3 title={story.title}>{title}</h3>
    <div class="news-card-footer">
      <time datetime={timestamp}>{published(timestamp)}</time>
      {sourceCount > 1 && (
        <span class="news-card-coverage" title={`Covered by ${sourceCount} sources`}>
          <i class="ph ph-stack" aria-hidden="true"></i>
          {sourceCount} sources
        </span>
      )}
      {readMinutes && <span>{readMinutes} min read</span>}
    </div>
    {showSummary && story.summary && <p class="news-card-summary">{story.summary}</p>}
    <button class="news-card-save" type="button" data-read-later-toggle={story.id} aria-label="Save to Read Later" aria-pressed="false" title="Save to Read Later">
      <i class="ph ph-bookmark-simple" aria-hidden="true"></i>
    </button>
  </div>
</article>

<style is:global>
  .news-card {
    position: relative;
  }

  .news-card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .news-card-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .news-card-body {
    position: relative;
    padding-bottom: 56px !important;
  }

  .news-card-coverage {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent);
    font-size: 16px;
    font-weight: 700;
  }

  .news-card-coverage i {
    font-size: 16px;
  }

  .news-card-save {
    position: absolute;
    z-index: 4;
    right: 10px;
    bottom: 8px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .news-card-save i {
    font-size: 22px;
  }

  .news-card-save:hover,
  .news-card-save:focus-visible,
  .news-card-save.is-saved {
    color: var(--accent);
  }

  .news-card-save:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .news-card-save:disabled {
    opacity: 0.55;
    cursor: default;
  }

  /* Keep every carousel publisher mark on one stable visual canvas. */
  .editorial-carousel-card .card-source-mark-slot {
    width: 168px;
    height: 32px;
    min-width: 168px;
    min-height: 32px;
    flex: 0 0 32px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
  }

  .editorial-carousel-card .card-source-mark-slot .card-source-mark {
    width: 168px !important;
    height: 32px !important;
    min-width: 168px !important;
    max-width: 168px !important;
    min-height: 32px !important;
    max-height: 32px !important;
    object-fit: contain !important;
    object-position: left center !important;
    flex: 0 0 168px !important;
    transform: none !important;
  }

  .editorial-carousel-card .news-card-photo-backdrop {
    display: none;
  }

  @media (max-width: 720px) {
    /* Match the exact mobile feed gutter instead of subtracting another 24px. */
    .editorial-front.shell {
      width: 100% !important;
      max-width: none !important;
      margin-inline: 0 !important;
      padding-left: var(--page-gutter-mobile, 20px) !important;
      padding-right: var(--page-gutter-mobile, 20px) !important;
    }

    .editorial-carousel-ready,
    .editorial-carousel-viewport,
    .editorial-carousel-track,
    .editorial-carousel-slide,
    .editorial-carousel-card.news-card.card-featured {
      width: 100% !important;
      max-width: none !important;
    }

    /* Every featured image gets a true 16:9 frame. */
    .editorial-carousel-card.news-card.card-featured .news-card-media {
      position: relative !important;
      display: block !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      aspect-ratio: 16 / 9 !important;
      overflow: hidden !important;
      background: var(--gray-6) !important;
    }

    .editorial-carousel-card.news-card.card-featured .news-card-photo {
      position: absolute !important;
      z-index: 1;
      inset: 0;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      object-fit: cover !important;
      object-position: var(--focus-x, 50%) var(--focus-y, 50%) !important;
      transform: none !important;
    }

    /* A roughly 1:1 source stays square. The same art fills and blurs behind it. */
    .editorial-carousel-card.news-card.card-featured .news-card-media.is-square-image .news-card-photo-backdrop {
      position: absolute !important;
      z-index: 0;
      inset: -8%;
      display: block !important;
      width: 116% !important;
      height: 116% !important;
      max-width: none !important;
      object-fit: cover !important;
      object-position: center !important;
      filter: blur(22px) saturate(1.08);
      transform: scale(1.08) !important;
      opacity: 0.78;
    }

    .editorial-carousel-card.news-card.card-featured .news-card-media.is-square-image .news-card-photo {
      object-fit: contain !important;
      object-position: center !important;
    }

    .editorial-carousel-card .card-source-mark-slot {
      width: 150px;
      min-width: 150px;
      height: 28px;
      min-height: 28px;
      flex-basis: 28px;
    }

    .editorial-carousel-card .card-source-mark-slot .card-source-mark {
      width: 150px !important;
      min-width: 150px !important;
      max-width: 150px !important;
      height: 28px !important;
      min-height: 28px !important;
      max-height: 28px !important;
      flex-basis: 150px !important;
    }
  }
</style>

<script>
  function initialiseCardImageFallbacks() {
    const images = [...document.querySelectorAll('.news-card-photo')];

    images.forEach((item) => {
      if (!(item instanceof HTMLImageElement)) return;

      let fallbacks = [];
      try {
        const parsed = JSON.parse(item.dataset.imageFallbacks || '[]');
        if (Array.isArray(parsed)) fallbacks = parsed.filter(Boolean);
      } catch {
        fallbacks = [];
      }

      const syncFeaturedMedia = () => {
        const card = item.closest('.news-card.card-featured');
        const media = item.closest('.news-card-media');
        if (!(card instanceof HTMLElement) || !(media instanceof HTMLElement)) return;
        if (!item.naturalWidth || !item.naturalHeight) return;

        const ratio = item.naturalWidth / item.naturalHeight;
        const isSquare = ratio >= 0.92 && ratio <= 1.08;
        const storyId = card.dataset.storyId || '';
        const src = item.currentSrc || item.src;

        [...document.querySelectorAll('.news-card.card-featured')].forEach((candidate) => {
          if (!(candidate instanceof HTMLElement) || candidate.dataset.storyId !== storyId) return;
          const candidateMedia = candidate.querySelector('.news-card-media');
          if (!(candidateMedia instanceof HTMLElement)) return;
          candidateMedia.classList.toggle('is-square-image', isSquare);
          candidateMedia.classList.toggle('is-fill-image', !isSquare);
          const backdrop = candidateMedia.querySelector('.news-card-photo-backdrop');
          if (backdrop instanceof HTMLImageElement && src) backdrop.src = src;
        });
      };

      let fallbackIndex = 0;
      const useNextImage = () => {
        const next = fallbacks[fallbackIndex];
        fallbackIndex += 1;
        if (next) {
          item.src = next;
          return;
        }

        item.closest('.news-card-media')?.remove();
        item.closest('.news-card')?.classList.add('no-image');
      };

      item.addEventListener('load', syncFeaturedMedia);
      item.addEventListener('error', useNextImage);
      if (item.complete) {
        if (item.naturalWidth === 0) useNextImage();
        else syncFeaturedMedia();
      }
    });
  }

  function initialiseSourceLogoSizing() {
    const logos = [...document.querySelectorAll('.card-source-mark')];

    logos.forEach((item) => {
      if (!(item instanceof HTMLImageElement)) return;

      const classify = () => {
        if (!item.naturalWidth || !item.naturalHeight) return;
        const isLandscape = item.naturalWidth > item.naturalHeight;
        item.classList.toggle('is-landscape-logo', isLandscape);
        item.classList.toggle('is-portrait-logo', !isLandscape);
      };

      if (item.complete) classify();
      else item.addEventListener('load', classify, { once: true });
    });
  }

  function initialiseHomeCardLookahead() {
    const home = document.querySelector('.home-page');
    if (!home) return;

    const cards = [...home.querySelectorAll('.news-card')];
    if (!cards.length) return;

    const warmed = new Set();
    const warmNextThree = (startIndex) => {
      let remaining = 3;
      for (let index = Math.max(3, startIndex); index < cards.length && remaining > 0; index += 1) {
        const image = cards[index].querySelector('.news-card-photo');
        if (!(image instanceof HTMLImageElement)) continue;
        const src = image.currentSrc || image.src;
        if (!src) continue;
        if (image.complete || warmed.has(src)) {
          remaining -= 1;
          continue;
        }
        const preload = new Image();
        preload.decoding = 'async';
        preload.fetchPriority = 'low';
        preload.src = src;
        warmed.add(src);
        remaining -= 1;
      }
    };

    warmNextThree(3);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const index = cards.indexOf(entry.target);
        if (index >= 0) warmNextThree(index + 1);
      }
    }, { rootMargin: '75% 0px 75% 0px', threshold: 0.01 });

    cards.forEach((card) => observer.observe(card));
  }

  function initialiseEditorialCarousels() {
    const grids = [...document.querySelectorAll('.editorial-front-grid:not(.editorial-carousel-ready)')];
    if (!grids.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_DELAY = 5600;
    const RESUME_DELAY = 7200;

    grids.forEach((grid, carouselIndex) => {
      const cards = [...grid.querySelectorAll('.news-card.searchable')];
      if (!cards.length) return;

      const section = grid.closest('[data-editorial-section]');
      const slides = cards.map((card, index) => {
        card.classList.remove('editorial-lead-card', 'editorial-support-card');
        card.classList.add('editorial-carousel-card');

        const slide = document.createElement('div');
        slide.className = 'editorial-carousel-slide';
        slide.dataset.carouselRealSlide = String(index);
        slide.append(card);
        return slide;
      });

      const viewport = document.createElement('div');
      viewport.className = 'editorial-carousel-viewport';
      viewport.setAttribute('aria-roledescription', 'carousel');
      viewport.setAttribute('aria-label', 'Top stories');
      viewport.style.touchAction = 'pan-y';

      const track = document.createElement('div');
      track.className = 'editorial-carousel-track';
      track.setAttribute('aria-live', 'off');
      slides.forEach((slide) => track.append(slide));
      viewport.append(track);

      const dots = document.createElement('div');
      dots.className = 'editorial-carousel-dots';
      dots.setAttribute('role', 'group');
      dots.setAttribute('aria-label', 'Choose a top story');

      grid.replaceChildren(viewport, dots);
      grid.classList.add('editorial-carousel-ready');
      grid.dataset.carouselIndex = String(carouselIndex);

      let visibleSlides = [];
      let current = 0;
      let physical = 0;
      let pendingJump = null;
      let autoTimer = 0;
      let resumeTimer = 0;
      let pointerId = null;
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let dragAxis = '';
      let suppressClick = false;

      const clearAuto = () => {
        if (autoTimer) window.clearInterval(autoTimer);
        autoTimer = 0;
      };

      const clearResume = () => {
        if (resumeTimer) window.clearTimeout(resumeTimer);
        resumeTimer = 0;
      };

      const setTrackPosition = (index, animate = true, offset = 0) => {
        track.classList.toggle('is-jumping', !animate || reduceMotion);
        track.style.transform = `translate3d(calc(${-index * 100}% + ${offset}px), 0, 0)`;
        if (!animate && !reduceMotion) {
          requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('is-jumping')));
        }
      };

      const updateSlideAccess = () => {
        visibleSlides.forEach((slide, index) => {
          const active = index === current;
          slide.toggleAttribute('inert', !active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
      };

      const updateDots = () => {
        [...dots.querySelectorAll('button')].forEach((dot, index) => {
          const active = index === current;
          dot.classList.toggle('active', active);
          dot.setAttribute('aria-current', active ? 'true' : 'false');
        });
      };

      const decorateClone = (clone) => {
        clone.dataset.carouselClone = 'true';
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('inert', '');
        clone.querySelectorAll('[id]').forEach((item) => item.removeAttribute('id'));
        const cloneCard = clone.querySelector('.news-card');
        if (cloneCard) {
          cloneCard.classList.remove('searchable', 'filtered-out', 'home-card-reveal', 'is-revealed');
          cloneCard.dataset.carouselCloneCard = 'true';
          cloneCard.style.removeProperty('--home-card-reveal-delay');
        }
        clone.querySelectorAll('[data-read-later-toggle]').forEach((item) => item.removeAttribute('data-read-later-toggle'));
        return clone;
      };

      const startAuto = () => {
        clearAuto();
        if (reduceMotion || visibleSlides.length <= 1) return;
        autoTimer = window.setInterval(() => {
          if (document.hidden || section?.hidden || pointerId !== null) return;
          moveNext();
        }, AUTO_DELAY);
      };

      const resumeAutoLater = (delay = RESUME_DELAY) => {
        clearAuto();
        clearResume();
        if (reduceMotion || visibleSlides.length <= 1) return;
        resumeTimer = window.setTimeout(startAuto, delay);
      };

      const moveTo = (target) => {
        if (visibleSlides.length <= 1) return;
        current = Math.max(0, Math.min(target, visibleSlides.length - 1));
        physical = current + 1;
        pendingJump = null;
        setTrackPosition(physical, true);
        updateSlideAccess();
        updateDots();
      };

      const moveNext = () => {
        const count = visibleSlides.length;
        if (count <= 1) return;
        if (current === count - 1) {
          current = 0;
          physical = count + 1;
          pendingJump = 1;
        } else {
          current += 1;
          physical = current + 1;
          pendingJump = null;
        }
        setTrackPosition(physical, true);
        updateSlideAccess();
        updateDots();
      };

      const movePrevious = () => {
        const count = visibleSlides.length;
        if (count <= 1) return;
        if (current === 0) {
          current = count - 1;
          physical = 0;
          pendingJump = count;
        } else {
          current -= 1;
          physical = current + 1;
          pendingJump = null;
        }
        setTrackPosition(physical, true);
        updateSlideAccess();
        updateDots();
      };

      const rebuild = () => {
        const previousStoryId = visibleSlides[current]?.querySelector('.news-card')?.dataset.storyId || '';
        [...track.querySelectorAll('[data-carousel-clone]')].forEach((clone) => clone.remove());

        slides.forEach((slide) => {
          const card = slide.querySelector('.news-card');
          const filtered = !card || card.classList.contains('filtered-out');
          slide.hidden = filtered;
          slide.removeAttribute('inert');
          slide.setAttribute('aria-hidden', filtered ? 'true' : 'false');
        });

        visibleSlides = slides.filter((slide) => !slide.hidden);
        const preservedIndex = visibleSlides.findIndex((slide) => slide.querySelector('.news-card')?.dataset.storyId === previousStoryId);
        current = preservedIndex >= 0 ? preservedIndex : 0;
        pendingJump = null;

        dots.replaceChildren();
        visibleSlides.forEach((slide, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'editorial-carousel-dot';
          button.setAttribute('aria-label', `Show top story ${index + 1} of ${visibleSlides.length}`);
          button.addEventListener('click', () => {
            clearAuto();
            moveTo(index);
            resumeAutoLater();
          });
          dots.append(button);
        });

        if (visibleSlides.length > 1) {
          const lastClone = decorateClone(visibleSlides[visibleSlides.length - 1].cloneNode(true));
          const firstClone = decorateClone(visibleSlides[0].cloneNode(true));
          track.prepend(lastClone);
          track.append(firstClone);
          physical = current + 1;
        } else {
          physical = 0;
        }

        dots.hidden = visibleSlides.length <= 1;
        setTrackPosition(physical, false);
        updateSlideAccess();
        updateDots();
        startAuto();
      };

      track.addEventListener('transitionend', (event) => {
        if (event.target !== track || event.propertyName !== 'transform' || pendingJump === null) return;
        physical = pendingJump;
        pendingJump = null;
        setTrackPosition(physical, false);
      });

      viewport.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || visibleSlides.length <= 1) return;
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        deltaX = 0;
        dragAxis = '';
        clearAuto();
        clearResume();
      });

      viewport.addEventListener('pointermove', (event) => {
        if (event.pointerId !== pointerId) return;
        const x = event.clientX - startX;
        const y = event.clientY - startY;

        if (!dragAxis && Math.max(Math.abs(x), Math.abs(y)) >= 7) {
          dragAxis = Math.abs(x) > Math.abs(y) ? 'horizontal' : 'vertical';
          if (dragAxis === 'horizontal') {
            try { viewport.setPointerCapture(pointerId); } catch {}
          }
        }

        if (dragAxis !== 'horizontal') return;
        event.preventDefault();
        deltaX = x;
        track.classList.add('is-dragging');
        setTrackPosition(physical, false, deltaX);
      });

      const finishPointer = (event) => {
        if (event.pointerId !== pointerId) return;
        const wasHorizontal = dragAxis === 'horizontal';
        const width = viewport.getBoundingClientRect().width || 1;
        const threshold = Math.min(72, Math.max(40, width * 0.12));
        const swipe = wasHorizontal && Math.abs(deltaX) >= threshold;

        track.classList.remove('is-dragging');
        if (swipe) {
          suppressClick = true;
          if (deltaX < 0) moveNext();
          else movePrevious();
        } else {
          setTrackPosition(physical, true);
        }

        try { viewport.releasePointerCapture(pointerId); } catch {}
        pointerId = null;
        deltaX = 0;
        dragAxis = '';
        resumeAutoLater();
        if (suppressClick) window.setTimeout(() => { suppressClick = false; }, 350);
      };

      viewport.addEventListener('pointerup', finishPointer);
      viewport.addEventListener('pointercancel', finishPointer);
      viewport.addEventListener('click', (event) => {
        if (!suppressClick) return;
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
      }, true);

      viewport.addEventListener('mouseenter', clearAuto);
      viewport.addEventListener('mouseleave', () => resumeAutoLater(2600));
      viewport.addEventListener('focusin', clearAuto);
      viewport.addEventListener('focusout', () => resumeAutoLater(3200));

      const filterObserver = new MutationObserver((mutations) => {
        const filterChanged = mutations.some((mutation) => {
          if (mutation.type !== 'attributes' || mutation.attributeName !== 'class') return false;
          const oldClasses = String(mutation.oldValue || '').split(/\s+/);
          const wasFiltered = oldClasses.includes('filtered-out');
          const isFiltered = mutation.target.classList.contains('filtered-out');
          return wasFiltered !== isFiltered;
        });
        if (filterChanged) rebuild();
      });

      cards.forEach((card) => filterObserver.observe(card, {
        attributes: true,
        attributeFilter: ['class'],
        attributeOldValue: true
      }));

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearAuto();
        else resumeAutoLater(1800);
      });

      rebuild();
    });
  }

  function initialiseNewsCards() {
    initialiseCardImageFallbacks();
    initialiseSourceLogoSizing();
    initialiseHomeCardLookahead();
    initialiseEditorialCarousels();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseNewsCards, { once: true });
  } else {
    initialiseNewsCards();
  }
</script>