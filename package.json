{
  "name": "forest-city-news",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python scripts/prepare_frontend.py && vite dev",
    "build": "python scripts/prepare_frontend.py && python scripts/build_search_index.py && vite build && python scripts/verify_svelte_pages_build.py",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "fetch": "python scripts/run_scoop.py"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.0"
  }
}
